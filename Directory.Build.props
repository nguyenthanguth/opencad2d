<Project>
    <!--
    One place for the things every project in this repository agrees on.

    OpenCAD2D has one version for all its projects. The assembly attributes are generated from it.
  -->

    <PropertyGroup>
        <OpenCAD2DVersion>2.0.0</OpenCAD2DVersion>
    </PropertyGroup>

    <PropertyGroup>
        <Version>$(OpenCAD2DVersion)</Version>
        <AssemblyVersion>$(OpenCAD2DVersion).0</AssemblyVersion>
        <FileVersion>$(OpenCAD2DVersion).0</FileVersion>
    </PropertyGroup>

    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <Deterministic>true</Deterministic>
    </PropertyGroup>

    <!--
    The core library, GeometryHelper (geometry, DXF and DWG), is used as a binary: Lib\GeometryHelper.dll with its XML
    documentation, built from the GeometryHelper repository (https://github.com/nguyenthanguth/GeometryHelper) at the
    commit Lib\VERSION.txt names. tools\update-lib.ps1 builds it there and copies it here.
  -->
    <PropertyGroup>
        <GeometryHelperLib>$(MSBuildThisFileDirectory)Lib\</GeometryHelperLib>
        <!--
        The version of that copy, read from the first line of Lib\VERSION.txt ("GeometryHelper 13.12.1, built ..."). The
        packages name it as their dependency: built with -p:GeometryHelperFromPackage=true, the projects compile against
        the GeometryHelper package of this version instead of Lib (Directory.Build.targets), so a package is never made
        against a copy of the core that nuget.org does not have.
      -->
        <GeometryHelperVersion>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('$(GeometryHelperLib)VERSION.txt')), '(?s)^GeometryHelper ([^,\s]+),.*$', '$1'))</GeometryHelperVersion>
    </PropertyGroup>

    <!-- Shared package identity. Anything specific to one project stays in its own project file. -->
    <PropertyGroup>
        <Authors>Nguyen Thang</Authors>
        <Company>Nguyen Thang</Company>
        <Product>OpenCAD2D</Product>
        <Copyright>Copyright © 2026 Nguyen Thang</Copyright>
        <RepositoryUrl>https://github.com/nguyenthanguth/opencad2d</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://nguyenthanguth.github.io/opencad2d/</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <PackageTags>cad 2d dxf dwg autocad autolisp dcl drawing plugin wpf</PackageTags>
    </PropertyGroup>
</Project>
