<Project Sdk="Microsoft.NET.Sdk">
    <!--
    The sample plugin that ships with the app, in Plugins\DrawingInfo: GHDWGINFO writes what the drawing holds. It
    references OpenCAD2D only, as a plugin does, and does not copy it: the app gives a plugin its own.
    OpenCAD2D.App copies this plugin's .dll into its Plugins folder when it builds. It has no plugin.json: the folder gives its name, DrawingInfo, and the assembly its version.
  -->
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsPackable>false</IsPackable>
        <Version>1.0.0</Version>
        <RootNamespace>OpenCAD2D.Plugins.DrawingInfo</RootNamespace>
        <AssemblyName>OpenCAD2D.Plugins.DrawingInfo</AssemblyName>
        <Description>A sample plugin for OpenCAD2D: the command GHDWGINFO writes the name, the objects by type, the layers, the blocks and the extents of the drawing.</Description>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\OpenCAD2D\OpenCAD2D.csproj" Private="false" />
        <Reference Include="GeometryHelper" HintPath="$(GeometryHelperLib)GeometryHelper.dll" Private="false" />
    </ItemGroup>
</Project>
