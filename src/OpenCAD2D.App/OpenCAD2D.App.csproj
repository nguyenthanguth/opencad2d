<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <PlatformTarget>x64</PlatformTarget>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RootNamespace>OpenCAD2D.App</RootNamespace>
        <AssemblyName>OpenCAD2D</AssemblyName>
        <!-- The exe is OpenCAD2D.exe; the engine beside it is OpenCAD2D.Core.dll. -->
        <AssemblyTitle>OpenCAD2D</AssemblyTitle>
        <StartupObject>OpenCAD2D.App.Program</StartupObject>
        <Description>OpenCAD2D: the standalone app that opens, edits and plots DXF and DWG drawings, laid out as AutoCAD 2D.</Description>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);MSB3277</NoWarn>
        <ApplicationIcon>Icons\app.ico</ApplicationIcon>
        <!--
        English only: the app's UI is English, so the translations .NET ships of WPF and WinForms (cs, de, es, ... zh-Hant,
        13 folders and 16 MB beside the exe of the self-contained setup) are left out of the build and the publish.
      -->
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    </PropertyGroup>

    <!-- The icons Icons\make-icons.ps1 writes: the window's, and a drawing file's, which the register switch names beside the exe. -->
    <ItemGroup>
        <EmbeddedResource Include="Icons\app.ico" LogicalName="OpenCAD2D.App.app.ico" />
        <None Include="Icons\drawing-file.ico" Link="drawing-file.ico" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <!--
    The sample source plugin, the folder Plugins\Stairs beside the exe: the example of the plugin guide, which a test of the
    Plugins suite holds byte for byte to the guide. A plugin of its own, never inside Plugins\DrawingInfo.
  -->
    <ItemGroup>
        <None
            Include="..\..\examples\Stairs\Stairs.csproj"
            Link="Plugins\Stairs\Stairs.csproj"
            CopyToOutputDirectory="PreserveNewest"
        />
        <None
            Include="..\..\examples\Stairs\StairsCommands.cs"
            Link="Plugins\Stairs\StairsCommands.cs"
            CopyToOutputDirectory="PreserveNewest"
        />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\OpenCAD2D.Wpf\OpenCAD2D.Wpf.csproj" />
        <ProjectReference Include="..\OpenCAD2D.Core\OpenCAD2D.Core.csproj" />
        <Reference Include="GeometryHelper" HintPath="$(GeometryHelperLib)GeometryHelper.dll" />
        <!-- Built first, never referenced: its .dll is copied below into Plugins\DrawingInfo, where the app loads it at start. -->
        <ProjectReference
            Include="..\..\examples\OpenCAD2D.Plugins.DrawingInfo\OpenCAD2D.Plugins.DrawingInfo.csproj"
            ReferenceOutputAssembly="false"
            OutputItemType="DrawingInfoPlugin"
        />
    </ItemGroup>

    <!--
    The sample plugin, Plugins\DrawingInfo, beside the exe: its .dll and nothing else. Not OpenCAD2D.Core.dll: the
    app gives a plugin its own. The item is a None item with a link, so that publish copies it as the build does.
  -->
    <Target Name="LinkDrawingInfoPlugin" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveProjectReferences">
        <ItemGroup>
            <None
                Include="@(DrawingInfoPlugin)"
                Link="Plugins\DrawingInfo\%(Filename)%(Extension)"
                CopyToOutputDirectory="PreserveNewest"
            />
        </ItemGroup>
    </Target>
</Project>
