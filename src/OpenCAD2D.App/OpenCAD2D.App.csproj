<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <PlatformTarget>x64</PlatformTarget>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RootNamespace>OpenCAD2D.App</RootNamespace>
        <AssemblyName>OpenCAD2D</AssemblyName>
        <!-- The exe is OpenCAD2D.exe; the engine beside it is OpenCAD2D.Core.dll. -->
        <AssemblyTitle>OpenCAD2D</AssemblyTitle>
        <StartupObject>OpenCAD2D.App.Program</StartupObject>
        <Description>OpenCAD2D: the standalone app that opens, edits and plots DXF and DWG drawings, laid out as AutoCAD 2D.</Description>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);MSB3277</NoWarn>
        <ApplicationIcon>Icons\app.ico</ApplicationIcon>
        <!--
        English only: the app's UI is English, so the translations .NET ships of WPF and WinForms (cs, de, es, ... zh-Hant,
        13 folders and 16 MB beside the exe of the self-contained setup) are left out of the build and the publish.
      -->
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    </PropertyGroup>

    <!-- The icons Icons\make-icons.ps1 writes: the window's, and a drawing file's, which the register switch names beside the exe. -->
    <ItemGroup>
        <EmbeddedResource Include="Icons\app.ico" LogicalName="OpenCAD2D.App.app.ico" />
        <None Include="Icons\drawing-file.ico" Link="drawing-file.ico" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <!--
    The sample source plugins, the folders Plugins\DrawingInfo, Plugins\DrawRandom and Plugins\HelloWorld beside the exe: a
    .csproj and the source each, which the app compiles at its first start and keeps the build of. Each a plugin of its own,
    never inside another.
  -->
    <ItemGroup>
        <None
            Include="..\..\examples\DrawingInfo\DrawingInfo.csproj"
            Link="Plugins\DrawingInfo\DrawingInfo.csproj"
            CopyToOutputDirectory="PreserveNewest"
        />
        <None
            Include="..\..\examples\DrawingInfo\DrawingInfoCommands.cs"
            Link="Plugins\DrawingInfo\DrawingInfoCommands.cs"
            CopyToOutputDirectory="PreserveNewest"
        />
        <None
            Include="..\..\examples\DrawRandom\DrawRandom.csproj"
            Link="Plugins\DrawRandom\DrawRandom.csproj"
            CopyToOutputDirectory="PreserveNewest"
        />
        <None
            Include="..\..\examples\DrawRandom\DrawRandomCommands.cs"
            Link="Plugins\DrawRandom\DrawRandomCommands.cs"
            CopyToOutputDirectory="PreserveNewest"
        />
        <None
            Include="..\..\examples\HelloWorld\HelloWorld.csproj"
            Link="Plugins\HelloWorld\HelloWorld.csproj"
            CopyToOutputDirectory="PreserveNewest"
        />
        <None
            Include="..\..\examples\HelloWorld\HelloWorldCommands.cs"
            Link="Plugins\HelloWorld\HelloWorldCommands.cs"
            CopyToOutputDirectory="PreserveNewest"
        />
    </ItemGroup>

    <!--
    The sample Python tools, the folders Pythons\DrawingInfo, Pythons\DrawRandom and Pythons\HelloWorld beside the exe: a
    requirements.txt (empty), the __init__.py and the plugin.json of each. The app loads them at its start (no Python starts
    then), and their process starts at the first PYINFO, PYRANDOM or PYHELLOWORLD.
  -->
    <ItemGroup>
        <None
            Include="..\..\examples\Pythons\DrawingInfo\*"
            Link="Pythons\DrawingInfo\%(Filename)%(Extension)"
            CopyToOutputDirectory="PreserveNewest"
        />
        <None
            Include="..\..\examples\Pythons\DrawRandom\*"
            Link="Pythons\DrawRandom\%(Filename)%(Extension)"
            CopyToOutputDirectory="PreserveNewest"
        />
        <None
            Include="..\..\examples\Pythons\HelloWorld\*"
            Link="Pythons\HelloWorld\%(Filename)%(Extension)"
            CopyToOutputDirectory="PreserveNewest"
        />
    </ItemGroup>

    <!--
    What a Python tool's venv is made from, in python beside the exe: the app's own copy of the package opencad2d (which a tool's
    process imports through the .pth file of its venv), tool.py, which a tool's process runs, the runtime config pythonnet starts
    .NET with, and the wheels of pythonnet 3.2.1, clr_loader 0.3.1, pycparser 3.12 and cffi 2.1.1 (one for each of Python 3.11 to
    3.15; 1.3 MB in all), from which the base of each Python version is installed once, with no network.
  -->
    <ItemGroup>
        <None
            Include="..\python\opencad2d\__init__.py"
            Link="python\opencad2d\__init__.py"
            CopyToOutputDirectory="PreserveNewest"
        />
        <None
            Include="..\python\opencad2d\arrays.py"
            Link="python\opencad2d\arrays.py"
            CopyToOutputDirectory="PreserveNewest"
        />
        <None
            Include="..\python\opencad2d\parallel.py"
            Link="python\opencad2d\parallel.py"
            CopyToOutputDirectory="PreserveNewest"
        />
        <None
            Include="..\python\opencad2d\synth.py"
            Link="python\opencad2d\synth.py"
            CopyToOutputDirectory="PreserveNewest"
        />
        <None
            Include="..\python\opencad2d\cad\*.py"
            Link="python\opencad2d\cad\%(Filename)%(Extension)"
            CopyToOutputDirectory="PreserveNewest"
        />
        <None
            Include="..\python\opencad2d\py.typed"
            Link="python\opencad2d\py.typed"
            CopyToOutputDirectory="PreserveNewest"
        />
        <None
            Include="..\python\opencad2d\tool.py"
            Link="python\opencad2d\tool.py"
            CopyToOutputDirectory="PreserveNewest"
        />
        <None
            Include="..\python\opencad2d\opencad2d.runtimeconfig.json"
            Link="python\opencad2d\opencad2d.runtimeconfig.json"
            CopyToOutputDirectory="PreserveNewest"
        />
        <None
            Include="python-wheels\*.whl"
            Link="python\wheels\%(Filename)%(Extension)"
            CopyToOutputDirectory="PreserveNewest"
        />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\OpenCAD2D.Wpf\OpenCAD2D.Wpf.csproj" />
        <ProjectReference Include="..\OpenCAD2D.Core\OpenCAD2D.Core.csproj" />
        <Reference Include="GeometryHelper" HintPath="$(GeometryHelperLib)GeometryHelper.dll" />
    </ItemGroup>

    <!--
    OpenCAD2D.Mcp.exe, the MCP server an AI agent drives OpenCAD2D with, is published into the folder of the app, so that every
    installed copy has it beside OpenCAD2D.exe. The app loads none of its code: the reference is for the build order and the
    restore of its runtime, and the publish below puts its files (and the SDK's packages, which the app has no use for) in place.
  -->
    <ItemGroup>
        <ProjectReference Include="..\OpenCAD2D.Mcp\OpenCAD2D.Mcp.csproj" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <Target Name="PublishMcpServer" AfterTargets="Publish">
        <MSBuild
            Projects="..\OpenCAD2D.Mcp\OpenCAD2D.Mcp.csproj"
            Targets="Publish"
            Properties="PublishDir=$(PublishDir)"
        />
    </Target>
</Project>
