<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <PlatformTarget>x64</PlatformTarget>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RootNamespace>OpenCAD2D</RootNamespace>
        <AssemblyName>OpenCAD2D.Core</AssemblyName>
        <Description>The engine of OpenCAD2D, a 2D CAD app that works like AutoCAD 2021, with no UI: DXF and DWG drawings opened as documents, drawn into 2D display lists, picked, and edited through AutoCAD's commands on a command line; AutoLISP and DCL, plot to PDF, command plugins and the Remote server. Its default fonts, hatch patterns, linetypes and template are copied beside the program that uses it.</Description>
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="GeometryHelper" HintPath="$(GeometryHelperLib)GeometryHelper.dll" />
        <ProjectReference Include="..\OpenCAD2D.Remote\OpenCAD2D.Remote.csproj" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Text\english-words.txt.gz" LogicalName="OpenCAD2D.english-words.txt.gz" />
    </ItemGroup>

    <!--
    The default support folders, beside OpenCAD2D.Core.dll in the output of every project that uses it; in the package as
    content files that a project referencing it copies to its output the same way.
  -->
    <ItemGroup>
        <None
            Update="Fonts\**;Hatches\**;Linetypes\**;Lisps\**;Pythons\**;Plugins\**;DrawingTemplates\**"
            CopyToOutputDirectory="PreserveNewest"
            Pack="true"
            PackageCopyToOutput="true"
        />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="OpenCAD2D.UnitTest" />
        <InternalsVisibleTo Include="OpenCAD2D.Remote.UnitTest" />
        <InternalsVisibleTo Include="OpenCAD2D.Wpf" />
        <InternalsVisibleTo Include="OpenCAD2D.Python" />
        <InternalsVisibleTo Include="OpenCAD2D.Wpf.UnitTest" />
    </ItemGroup>
</Project>
