<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <PlatformTarget>x64</PlatformTarget>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RootNamespace>OpenCAD2D.Remote</RootNamespace>
        <AssemblyName>OpenCAD2D.Remote</AssemblyName>
        <Description>Drives a running OpenCAD2D from another program: finds the app, lists its drawings, reads and edits their entities and sends commands, the way a Tekla Open API program drives a running Tekla Structures.</Description>
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="GeometryHelper" HintPath="$(GeometryHelperLib)GeometryHelper.dll" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="OpenCAD2D.Core" />
        <InternalsVisibleTo Include="OpenCAD2D.Wpf" />
        <InternalsVisibleTo Include="OpenCAD2D.Remote.UnitTest" />
        <InternalsVisibleTo Include="OpenCAD2D.Wpf.UnitTest" />
    </ItemGroup>
</Project>
