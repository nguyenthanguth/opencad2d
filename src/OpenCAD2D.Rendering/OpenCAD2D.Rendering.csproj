<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RootNamespace>OpenCAD2D.Rendering</RootNamespace>
        <AssemblyName>OpenCAD2D.Rendering</AssemblyName>
        <Description>The drawing of OpenCAD2D with no window: a display list drawn with SkiaSharp into pixels, a PDF writer and a raster writer. The canvas of the presenter, the plot and the Python wheel all draw through it.</Description>
        <IsPackable>false</IsPackable>
        <!-- Kept beside this DLL, where a program that loads it from a folder finds SkiaSharp and its native library. -->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\OpenCAD2D.Core\OpenCAD2D.Core.csproj" />
        <Reference Include="GeometryHelper" HintPath="$(GeometryHelperLib)GeometryHelper.dll" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="SkiaSharp" Version="4.155.0" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="OpenCAD2D.Wpf" />
        <InternalsVisibleTo Include="OpenCAD2D.UnitTest" />
        <InternalsVisibleTo Include="OpenCAD2D.Wpf.UnitTest" />
        <InternalsVisibleTo Include="OpenCAD2D.Plugins.UnitTest" />
    </ItemGroup>
</Project>
