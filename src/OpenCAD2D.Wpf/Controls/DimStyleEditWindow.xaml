<Window
    x:Class="OpenCAD2D.Wpf.DimStyleEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:OpenCAD2D.Wpf"
    Title="Dimension Style"
    Width="860"
    Height="660"
    MinWidth="860"
    MinHeight="660"
    WindowStyle="None"
    ResizeMode="CanResizeWithGrip"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary Source="/OpenCAD2D.Wpf;component/Themes/StyleDialogs.xaml" />
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <!-- Header: the title, dragged to move the dialog, and the close button (Cancel). -->
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Command="{Binding CancelCommand}"
                        ToolTip="Close"
                    />
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Footer: what the words beside the fields are, then Cancel and OK. -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button
                            Style="{StaticResource StylePrimaryButton}"
                            Content="OK"
                            Padding="14,5"
                            MinWidth="75"
                            Margin="0,0,8,0"
                            Click="OnOk"
                            IsDefault="True"
                        />
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="Cancel"
                            Padding="14,5"
                            MinWidth="75"
                            Command="{Binding CancelCommand}"
                            IsCancel="True"
                        />
                    </StackPanel>
                    <TextBlock
                        Text="Dimension variables are shown beside each field."
                        Foreground="{StaticResource GhTextMuted}"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>

            <!-- The seven tabs, in the design's order, over a line. -->
            <Border
                DockPanel.Dock="Top"
                Padding="16,8,16,0"
                BorderBrush="{StaticResource GhBorder}"
                BorderThickness="0,0,0,1"
            >
                <ItemsControl ItemsSource="{Binding TabChips}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton
                                Style="{StaticResource StyleTab}"
                                Content="{Binding Name}"
                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            >
                                <RadioButton.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding}" />
                                            <!-- The accent dot: a field of this tab sets the part of the preview under the pointer. -->
                                            <Ellipse
                                                x:Name="Dot"
                                                Width="6"
                                                Height="6"
                                                Margin="6,0,0,0"
                                                Fill="{StaticResource GhAccent}"
                                                Visibility="Collapsed"
                                            />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger
                                                Binding="{Binding DataContext.HasLitField, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                Value="True"
                                            >
                                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </RadioButton.ContentTemplate>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!--
            The tab shown, in group boxes as AutoCAD lays it out: the preview at the top right (300 wide) with the right column's
            boxes under it, the left column's boxes beside it, the wide boxes across the width, then the description of the tab
            and what OK does. It scrolls where the window is too short.
            -->
            <ScrollViewer x:Name="FieldsScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="TabBody" Margin="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="300" />
                        </Grid.ColumnDefinitions>
                        <ItemsControl
                            x:Name="LeftGroups"
                            VerticalAlignment="Top"
                            ItemsSource="{Binding LeftGroups}"
                            ItemTemplate="{StaticResource DimGroupTemplate}"
                            Focusable="False"
                        />
                        <StackPanel Grid.Column="2">
                            <local:StylePreviewPanel
                                Title="{Binding PreviewTitle}"
                                Model="{Binding PreviewModel}"
                                Height="220"
                                Margin="0,0,0,10"
                            />
                            <ItemsControl
                                x:Name="RightGroups"
                                ItemsSource="{Binding RightGroups}"
                                ItemTemplate="{StaticResource DimGroupTemplate}"
                                Focusable="False"
                            />
                        </StackPanel>
                    </Grid>
                    <ItemsControl
                        x:Name="WideGroups"
                        ItemsSource="{Binding WideGroups}"
                        ItemTemplate="{StaticResource DimGroupTemplate}"
                        Focusable="False"
                    />
                    <Border Style="{StaticResource StyleFrame}" Margin="0,0,0,8">
                        <DockPanel>
                            <TextBlock
                                DockPanel.Dock="Left"
                                Text="Description"
                                Margin="0,0,8,0"
                                Foreground="{StaticResource GhTextMuted}"
                            />
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource StyleFrame}">
                        <DockPanel>
                            <Ellipse
                                DockPanel.Dock="Left"
                                Width="8"
                                Height="8"
                                Margin="0,4,8,0"
                                VerticalAlignment="Top"
                                Style="{StaticResource NoticeDot}"
                            />
                            <TextBlock
                                Text="{Binding Notice}"
                                Foreground="{StaticResource GhTextMuted}"
                                TextWrapping="Wrap"
                            />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
