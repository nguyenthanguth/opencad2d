<Window
    x:Class="OpenCAD2D.Wpf.MTextSizeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{Binding Title}"
    Width="290"
    SizeToContent="Height"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary Source="/OpenCAD2D.Wpf;component/Themes/BlockDialogs.xaml" />
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="12,6"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnCancel"
                        ToolTip="Close"
                    />
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="12,6">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        Style="{StaticResource StylePrimaryButton}"
                        Content="OK"
                        Padding="14,5"
                        MinWidth="75"
                        Margin="0,0,6,0"
                        Click="OnOk"
                        IsDefault="True"
                    />
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="Cancel"
                        Padding="14,5"
                        MinWidth="75"
                        Click="OnCancel"
                        IsCancel="True"
                    />
                </StackPanel>
            </Border>
            <StackPanel Margin="12,10">
                <DockPanel>
                    <TextBox
                        x:Name="ValueBox"
                        DockPanel.Dock="Right"
                        Width="110"
                        Style="{StaticResource BlockNumber}"
                        Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="{Binding Label}"
                    />
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock
                    Margin="0,6,0,0"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource GhProblem}"
                    Text="{Binding Notice}"
                />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
