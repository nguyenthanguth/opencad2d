<UserControl
    x:Class="OpenCAD2D.Wpf.ModelViewsTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:OpenCAD2D.Wpf"
>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OpenCAD2D.Wpf;component/Themes/BlockDialogs.xaml" />
                <ResourceDictionary Source="/OpenCAD2D.Wpf;component/Themes/SheetSetTabs.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Design A12SsmModelViews, state 1: the toolbar (Refresh, Add New Location) over the tree of the resource locations, the
         drawings in them and their named model views. -->
    <DockPanel>
        <Border
            DockPanel.Dock="Top"
            BorderBrush="{StaticResource GhBorder}"
            BorderThickness="0,0,0,1"
            Padding="8,4"
            IsEnabled="{Binding HasSet}"
        >
            <StackPanel Orientation="Horizontal">
                <Button
                    Style="{StaticResource SsmTabTool}"
                    Click="OnRefresh"
                    ToolTip="Refresh"
                    AutomationProperties.Name="Refresh"
                >
                    <local:SheetSetIcon Glyph="refresh" Size="18" />
                </Button>
                <Button
                    Style="{StaticResource SsmTabTool}"
                    Click="OnAddLocation"
                    ToolTip="Add New Location"
                    AutomationProperties.Name="Add New Location"
                >
                    <local:SheetSetIcon Glyph="folder-add" Size="18" />
                </Button>
            </StackPanel>
        </Border>

        <Grid>
            <ListBox
                x:Name="Tree"
                ItemsSource="{Binding ModelRows}"
                ItemContainerStyle="{StaticResource SsmTabRow}"
                SelectionMode="Extended"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                Background="Transparent"
                BorderThickness="0"
                Padding="0,4"
                PreviewMouseLeftButtonDown="OnTreeMouseDown"
                PreviewMouseMove="OnTreeMouseMove"
                MouseDoubleClick="OnTreeDoubleClick"
                PreviewMouseRightButtonDown="OnTreeRightDown"
                ContextMenuOpening="OnTreeMenuOpening"
                PreviewKeyDown="OnTreeKeyDown"
            />
            <TextBlock
                Text="{Binding ModelsHint}"
                Foreground="{StaticResource GhTextMuted}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                LineHeight="18"
                Margin="16,64,16,0"
                VerticalAlignment="Top"
                IsHitTestVisible="False"
            />
        </Grid>
    </DockPanel>
</UserControl>
