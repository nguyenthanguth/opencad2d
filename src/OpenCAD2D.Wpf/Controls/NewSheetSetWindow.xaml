<Window
    x:Class="OpenCAD2D.Wpf.NewSheetSetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:OpenCAD2D.Wpf"
    Title="Create Sheet Set"
    Width="660"
    Height="470"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OpenCAD2D.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/OpenCAD2D.Wpf;component/Themes/StyleDialogs.xaml" />
                <ResourceDictionary Source="/OpenCAD2D.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:BoolToVisibilityConverter x:Key="Shown" />
            <local:BoolToVisibilityConverter x:Key="HiddenWhen" Invert="True" />
            <SolidColorBrush x:Key="WizFolder" Color="#E3B341" />
            <SolidColorBrush x:Key="WizFolderTint" Color="#33E3B341" />
            <SolidColorBrush x:Key="WizDisabled" Color="#6B7480" />
            <SolidColorBrush x:Key="WizErrorGround" Color="#3A2626" />

            <!-- A muted line of help under a choice. -->
            <Style x:Key="WizHelp" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
            </Style>

            <!-- A label over a box. -->
            <Style x:Key="WizLabel" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style x:Key="WizButton" TargetType="Button" BasedOn="{StaticResource GhDialogButton}">
                <Setter Property="Padding" Value="14,5" />
            </Style>

            <!-- The frame of a list or a box of the board. -->
            <Style x:Key="WizFrame" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource GhBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Background" Value="{StaticResource GhInput}" />
            </Style>

            <!-- The red box of a refusal, with its mark. -->
            <Style x:Key="WizRefusal" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource GhProblem}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Background" Value="{StaticResource WizErrorGround}" />
                <Setter Property="Padding" Value="10,6" />
            </Style>

            <!-- A row of a list: selected in the blue of the window's selections. -->
            <Style x:Key="WizRow" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{StaticResource GhText}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Row" Background="Transparent" Padding="4,2">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource GhHover}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter
                                        TargetName="Row"
                                        Property="Background"
                                        Value="{StaticResource GhSelected}"
                                    />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The box of a layout tree: ticked, clear, or mixed (a small square) where some of what is below is ticked. -->
            <Style x:Key="WizTreeCheck" TargetType="CheckBox">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border
                                x:Name="Box"
                                Width="13"
                                Height="13"
                                CornerRadius="2"
                                Background="{StaticResource GhInput}"
                                BorderBrush="{StaticResource GhTextMuted}"
                                BorderThickness="1"
                            >
                                <Grid>
                                    <Path
                                        x:Name="Tick"
                                        Data="M2.5 6.5 5 9 10 3.5"
                                        Stroke="White"
                                        StrokeThickness="1.6"
                                        StrokeStartLineCap="Round"
                                        StrokeEndLineCap="Round"
                                        StrokeLineJoin="Round"
                                        Visibility="Collapsed"
                                    />
                                    <Rectangle
                                        x:Name="Mixed"
                                        Width="7"
                                        Height="7"
                                        Fill="{StaticResource GhAccent}"
                                        Visibility="Collapsed"
                                    />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{StaticResource GhAccent}" />
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource GhAccent}" />
                                    <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="{x:Null}">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource GhAccent}" />
                                    <Setter TargetName="Mixed" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Box" Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The arrow that shows or hides the rows below. -->
            <Style x:Key="WizChevron" TargetType="ToggleButton">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Width" Value="14" />
                <Setter Property="Height" Value="14" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent">
                                <Path
                                    x:Name="Arrow"
                                    Data="M4 2.5 8 6.5 4 10.5"
                                    Stroke="{StaticResource GhTextMuted}"
                                    StrokeThickness="1.4"
                                    StrokeStartLineCap="Round"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Arrow" Property="Data" Value="M2.5 4 6.5 8 10.5 4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The picture of a folder, a drawing and a layout of the Choose Layouts tree. -->
            <Style x:Key="WizKind" TargetType="Path">
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Stretch" Value="None" />
                <Setter Property="StrokeThickness" Value="1.2" />
                <Setter Property="StrokeLineJoin" Value="Round" />
                <Setter Property="Stroke" Value="{StaticResource GhIcon}" />
                <Setter Property="Data" Value="M3 1.5h6l3.5 3.5v9.5H3z M9 1.5v3.5h3.5" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="Folder">
                        <Setter Property="Data" Value="M1.5 3.5h4.5l1.5 1.5h7v8h-13z" />
                        <Setter Property="Stroke" Value="{StaticResource WizFolder}" />
                        <Setter Property="Fill" Value="{StaticResource WizFolderTint}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Layout">
                        <Setter Property="Data" Value="M2 3.5h12v9h-12z M4.5 10h4" />
                        <Setter Property="Stroke" Value="{StaticResource GhAccent}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- A row of the Choose Layouts tree: indent, arrow, box, picture, name, and on the right why a layout is left out. -->
            <DataTemplate x:Key="LayoutRow" DataType="{x:Type local:NewSheetSetLayoutNode}">
                <DockPanel x:Name="Line" Height="22" ToolTip="{Binding Refusal}">
                    <Border DockPanel.Dock="Left" Width="{Binding Indent}" />
                    <ToggleButton
                        x:Name="Chevron"
                        DockPanel.Dock="Left"
                        Style="{StaticResource WizChevron}"
                        IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                        Margin="0,0,4,0"
                    />
                    <CheckBox
                        DockPanel.Dock="Left"
                        Style="{StaticResource WizTreeCheck}"
                        IsChecked="{Binding IsChecked, Mode=TwoWay}"
                        IsEnabled="{Binding IsCheckable}"
                        Margin="0,0,6,0"
                    />
                    <Path DockPanel.Dock="Left" Style="{StaticResource WizKind}" Margin="0,0,6,0" />
                    <TextBlock
                        DockPanel.Dock="Right"
                        Text="{Binding Note}"
                        FontSize="11"
                        Foreground="{StaticResource GhTextMuted}"
                        VerticalAlignment="Center"
                        Margin="12,0,6,0"
                    />
                    <TextBlock
                        x:Name="Words"
                        Text="{Binding Text}"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                    />
                </DockPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsExpandable}" Value="False">
                        <Setter TargetName="Chevron" Property="Visibility" Value="Hidden" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsRefused}" Value="True">
                        <Setter TargetName="Words" Property="Foreground" Value="{StaticResource WizDisabled}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Folder">
                        <Setter TargetName="Words" Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate x:Key="ExampleRow" DataType="{x:Type local:NewSheetSetExampleRow}">
                <StackPanel Orientation="Horizontal" Height="20">
                    <Path
                        Style="{StaticResource WizKind}"
                        Margin="2,0,8,0"
                        VerticalAlignment="Center"
                        Stroke="{StaticResource GhAccent}"
                    />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="PageRow" DataType="{x:Type local:NewSheetSetPageRow}">
                <Border x:Name="Line" Height="28" CornerRadius="3" Margin="8,0,8,2" Background="Transparent">
                    <DockPanel>
                        <Path
                            x:Name="Mark"
                            DockPanel.Dock="Left"
                            Data="M0 0 7 5 0 10z"
                            Fill="{StaticResource GhAccent}"
                            Margin="8,0,10,0"
                            VerticalAlignment="Center"
                            Visibility="Hidden"
                        />
                        <TextBlock
                            x:Name="Words"
                            Text="{Binding Title}"
                            Foreground="{StaticResource GhTextMuted}"
                            VerticalAlignment="Center"
                        />
                    </DockPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                        <Setter TargetName="Line" Property="Background" Value="{StaticResource GhSelected}" />
                        <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Words" Property="Foreground" Value="{StaticResource GhText}" />
                        <Setter TargetName="Words" Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Design A12WizardExample and A12WizardDrawings: NEWSHEETSET, 660 x 470. The route chosen on Begin decides the pages of the list down the left. -->
    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Command="{Binding CancelCommand}"
                        ToolTip="Close"
                    />
                    <TextBlock
                        Text="{Binding PageTitle}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button
                        Style="{StaticResource WizButton}"
                        Content="&lt; Back"
                        Padding="14,5"
                        MinWidth="75"
                        Margin="0,0,8,0"
                        Command="{Binding BackCommand}"
                    />
                    <Button
                        Style="{StaticResource StylePrimaryButton}"
                        Content="Next &gt;"
                        Padding="14,5"
                        MinWidth="75"
                        Margin="0,0,8,0"
                        Command="{Binding NextCommand}"
                        IsDefault="True"
                        Visibility="{Binding IsConfirmPage, Converter={StaticResource HiddenWhen}}"
                    />
                    <Button
                        Style="{StaticResource StylePrimaryButton}"
                        Content="Finish"
                        Padding="14,5"
                        MinWidth="75"
                        Margin="0,0,8,0"
                        Command="{Binding FinishCommand}"
                        IsDefault="True"
                        Visibility="{Binding IsConfirmPage, Converter={StaticResource Shown}}"
                    />
                    <Button
                        Style="{StaticResource WizButton}"
                        Content="Cancel"
                        Padding="14,5"
                        MinWidth="75"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"
                    />
                </StackPanel>
            </Border>

            <!-- The pages of the route, the one the wizard is at marked. -->
            <Border
                DockPanel.Dock="Left"
                Width="168"
                Background="{StaticResource GhBg}"
                BorderBrush="{StaticResource GhBorder}"
                BorderThickness="0,0,1,0"
            >
                <ItemsControl
                    ItemsSource="{Binding Pages}"
                    ItemTemplate="{StaticResource PageRow}"
                    Margin="0,12,0,0"
                    Focusable="False"
                />
            </Border>

            <!-- The red box of a refusal, for every page but Sheet Set Details, which has its own under the folder. -->
            <Border DockPanel.Dock="Bottom" Margin="16,0,16,12">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource WizRefusal}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasMessage}" Value="True" />
                                    <Condition Binding="{Binding IsDetailsPage}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock
                    Text="{Binding Message}"
                    Foreground="{StaticResource GhProblem}"
                    FontSize="11"
                    TextWrapping="Wrap"
                />
            </Border>

            <Grid Margin="16,14,16,12">
                <!-- Begin -->
                <StackPanel Visibility="{Binding IsBeginPage, Converter={StaticResource Shown}}">
                    <TextBlock Text="Create a sheet set using" Margin="0,0,0,14" />
                    <RadioButton
                        Style="{StaticResource BlockRadio}"
                        GroupName="Route"
                        Content="An example sheet set"
                        Margin="12,0,0,2"
                        IsChecked="{Binding IsFromExample, Mode=TwoWay}"
                    />
                    <TextBlock
                        Style="{StaticResource WizHelp}"
                        Margin="31,0,0,16"
                        Text="The new set copies the subsets, properties and templates of an example set (a .dst). Then add sheets with New Sheet or Import Layout as Sheet."
                    />
                    <RadioButton
                        Style="{StaticResource BlockRadio}"
                        GroupName="Route"
                        Content="Existing drawings"
                        Margin="12,0,0,2"
                        IsChecked="{Binding IsExistingDrawings, Mode=TwoWay}"
                    />
                    <TextBlock
                        Style="{StaticResource WizHelp}"
                        Margin="31,0,0,0"
                        Text="Pick folders of drawings; their layouts become the sheets, and subsets can follow the folders."
                    />
                </StackPanel>

                <!-- Sheet Set Example -->
                <DockPanel Visibility="{Binding IsExamplePage, Converter={StaticResource Shown}}">
                    <RadioButton
                        DockPanel.Dock="Top"
                        Style="{StaticResource BlockRadio}"
                        GroupName="Example"
                        Content="Select a sheet set to use as an example"
                        IsChecked="{Binding IsListedExample, Mode=TwoWay}"
                    />
                    <Border DockPanel.Dock="Top" Style="{StaticResource WizFrame}" Height="120" Margin="21,0,0,10">
                        <ListBox
                            AutomationProperties.Name="Examples"
                            ItemsSource="{Binding Examples}"
                            SelectedItem="{Binding SelectedExample, Mode=TwoWay}"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource WizRow}"
                            ItemTemplate="{StaticResource ExampleRow}"
                            IsEnabled="{Binding IsListedExample}"
                        />
                    </Border>
                    <RadioButton
                        DockPanel.Dock="Top"
                        Style="{StaticResource BlockRadio}"
                        GroupName="Example"
                        Content="Browse to another sheet set to use as an example"
                        IsChecked="{Binding IsBrowsedExample, Mode=TwoWay}"
                    />
                    <DockPanel DockPanel.Dock="Top" Margin="21,0,0,12" IsEnabled="{Binding IsBrowsedExample}">
                        <Button
                            DockPanel.Dock="Right"
                            Style="{StaticResource WizButton}"
                            Padding="10,3"
                            Margin="8,0,0,0"
                            Content="…"
                            Command="{Binding BrowseExampleCommand}"
                            ToolTip="Browse"
                        />
                        <TextBox
                            Style="{StaticResource BlockBox}"
                            AutomationProperties.Name="Example sheet set file"
                            Text="{Binding BrowsedExamplePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        />
                    </DockPanel>
                    <HeaderedContentControl
                        Style="{StaticResource BlockGroup}"
                        Header="{Binding ExampleTitle}"
                        Margin="0,2,0,0"
                    >
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Style="{StaticResource WizHelp}" Text="{Binding ExampleDetails}" />
                        </ScrollViewer>
                    </HeaderedContentControl>
                </DockPanel>

                <!-- Sheet Set Details -->
                <StackPanel Visibility="{Binding IsDetailsPage, Converter={StaticResource Shown}}">
                    <TextBlock Style="{StaticResource WizLabel}" Text="Name of new sheet set:" />
                    <TextBox
                        Style="{StaticResource BlockBox}"
                        AutomationProperties.Name="Name of new sheet set"
                        Margin="0,0,0,10"
                        Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    />
                    <TextBlock Style="{StaticResource WizLabel}" Text="Description (optional):" />
                    <TextBox
                        Style="{StaticResource BlockBox}"
                        AutomationProperties.Name="Description"
                        Height="48"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        VerticalContentAlignment="Top"
                        Margin="0,0,0,10"
                        Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    />
                    <TextBlock Style="{StaticResource WizLabel}" Text="Store sheet set data file (.dst) here:" />
                    <DockPanel Margin="0,0,0,8">
                        <Button
                            DockPanel.Dock="Right"
                            Style="{StaticResource WizButton}"
                            Padding="10,3"
                            Margin="8,0,0,0"
                            Content="…"
                            Command="{Binding BrowseFolderCommand}"
                            ToolTip="Browse"
                        />
                        <TextBox
                            Style="{StaticResource BlockBox}"
                            AutomationProperties.Name="Folder of the sheet set data file"
                            Text="{Binding Folder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        />
                    </DockPanel>
                    <Border
                        Style="{StaticResource WizRefusal}"
                        Margin="0,0,0,8"
                        Visibility="{Binding HasMessage, Converter={StaticResource Shown}}"
                    >
                        <TextBlock
                            Text="{Binding Message}"
                            Foreground="{StaticResource GhProblem}"
                            FontSize="11"
                            TextWrapping="Wrap"
                        />
                    </Border>
                    <TextBlock
                        Style="{StaticResource WizHelp}"
                        Margin="0,0,0,10"
                        Text="Note: keep the .dst where everyone working on the set can reach it."
                    />
                    <CheckBox
                        Style="{StaticResource BlockCheck}"
                        Content="Create a folder hierarchy based on subsets"
                        Margin="0,0,0,10"
                        IsChecked="{Binding CreateFolderHierarchy, Mode=TwoWay}"
                        Visibility="{Binding ShowFolderHierarchy, Converter={StaticResource Shown}}"
                    />
                    <Button
                        Style="{StaticResource WizButton}"
                        Content="Sheet Set Properties…"
                        HorizontalAlignment="Left"
                        Command="{Binding PropertiesCommand}"
                    />
                </StackPanel>

                <!-- Choose Layouts -->
                <DockPanel Visibility="{Binding IsLayoutsPage, Converter={StaticResource Shown}}">
                    <TextBlock
                        DockPanel.Dock="Top"
                        Text="Pick folders of drawings. The layouts checked become sheets."
                        Margin="0,0,0,8"
                    />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button
                            Style="{StaticResource WizButton}"
                            Content="Browse…"
                            Margin="0,0,8,0"
                            Command="{Binding AddFolderCommand}"
                        />
                        <Button
                            Style="{StaticResource WizButton}"
                            Content="Import Options…"
                            Command="{Binding ImportOptionsCommand}"
                        />
                    </StackPanel>
                    <Border Style="{StaticResource WizFrame}">
                        <ListBox
                            AutomationProperties.Name="Layouts"
                            ItemsSource="{Binding LayoutRows}"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource WizRow}"
                            ItemTemplate="{StaticResource LayoutRow}"
                            HorizontalContentAlignment="Stretch"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        />
                    </Border>
                </DockPanel>

                <!-- Confirm -->
                <DockPanel Visibility="{Binding IsConfirmPage, Converter={StaticResource Shown}}">
                    <TextBlock DockPanel.Dock="Top" Text="Sheet Set Preview:" Margin="0,0,0,6" />
                    <Border Style="{StaticResource WizFrame}" Padding="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{Binding PreviewTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding PreviewBody}" TextWrapping="Wrap" FontSize="11" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
