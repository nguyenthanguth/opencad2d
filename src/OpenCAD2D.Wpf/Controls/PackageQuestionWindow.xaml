<Window
    x:Class="OpenCAD2D.Wpf.PackageQuestionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:OpenCAD2D.Wpf"
    Title="{Binding Title}"
    Width="560"
    Height="440"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OpenCAD2D.Wpf;component/Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="Download" Color="#6CB6FF" />
            <Style x:Key="Head" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Margin" Value="8,6" />
            </Style>
            <Style x:Key="Cell" TargetType="TextBlock">
                <Setter Property="Margin" Value="8,6" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        CornerRadius="6"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                CornerRadius="6,6,0,0"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnNo"
                        ToolTip="Close"
                    />
                    <TextBlock
                        x:Name="TitleText"
                        Text="{Binding Title}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>

            <Border
                DockPanel.Dock="Bottom"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                CornerRadius="0,0,6,6"
            >
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button
                            x:Name="YesButton"
                            Style="{StaticResource GhAccentButton}"
                            Padding="14,5"
                            MinWidth="75"
                            Margin="0,0,8,0"
                            Content="{Binding YesLabel}"
                            Click="OnYes"
                        />
                        <Button
                            x:Name="NoButton"
                            Style="{StaticResource GhDialogButton}"
                            Padding="14,5"
                            MinWidth="75"
                            Content="{Binding NoLabel}"
                            Click="OnNo"
                            IsCancel="True"
                        />
                    </StackPanel>
                    <TextBlock
                        x:Name="SourceText"
                        Text="{Binding Source}"
                        Foreground="{StaticResource GhTextMuted}"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>

            <Grid Margin="16,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    x:Name="LeadText"
                    Text="{Binding Lead}"
                    Foreground="{StaticResource GhIcon}"
                    TextWrapping="Wrap"
                />

                <Border
                    Grid.Row="1"
                    Margin="0,10"
                    BorderBrush="{StaticResource GhBorder}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Background="{StaticResource GhInput}"
                >
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Background="{StaticResource GhHeader}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Head}" Text="Package" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Head}" Text="Version" />
                            <TextBlock
                                x:Name="ThirdHead"
                                Grid.Column="2"
                                Style="{StaticResource Head}"
                                Text="{Binding ThirdHead}"
                            />
                        </Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="PackageList" ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:PackageQuestionRow}">
                                        <Border BorderBrush="{StaticResource GhHeader}" BorderThickness="0,1,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="120" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    x:Name="Name"
                                                    Style="{StaticResource Cell}"
                                                    Text="{Binding Name}"
                                                    Foreground="{StaticResource GhIcon}"
                                                    ToolTip="{Binding Name}"
                                                />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Style="{StaticResource Cell}"
                                                    Text="{Binding Version}"
                                                    FontFamily="{StaticResource GhMonoFont}"
                                                />
                                                <TextBlock
                                                    x:Name="Note"
                                                    Grid.Column="2"
                                                    Style="{StaticResource Cell}"
                                                    Text="{Binding Note}"
                                                    Foreground="{StaticResource GhTextMuted}"
                                                />
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsDirect}" Value="True">
                                                <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
                                                <Setter
                                                    TargetName="Name"
                                                    Property="Foreground"
                                                    Value="{StaticResource GhText}"
                                                />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsNoteHighlighted}" Value="True">
                                                <Setter
                                                    TargetName="Note"
                                                    Property="Foreground"
                                                    Value="{StaticResource Download}"
                                                />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <TextBlock
                    x:Name="FootText"
                    Grid.Row="2"
                    Text="{Binding Foot}"
                    Foreground="{StaticResource GhTextMuted}"
                    TextWrapping="Wrap"
                />
            </Grid>
        </DockPanel>
    </Border>
</Window>
