<Window
    x:Class="OpenCAD2D.Wpf.PluginSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:OpenCAD2D.Wpf"
    Title="{Binding Title}"
    Width="540"
    SizeToContent="Height"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OpenCAD2D.Wpf;component/Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="Refused" Color="#FF8A7A" />
            <Style x:Key="Small" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,3,0,0" />
            </Style>
            <Style x:Key="Box" TargetType="Border">
                <Setter Property="Width" Value="180" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="{StaticResource GhInput}" />
                <Setter Property="BorderBrush" Value="{StaticResource GhBorder}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasError}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource Refused}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        CornerRadius="6"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                CornerRadius="6,6,0,0"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnCancel"
                        ToolTip="Close"
                    />
                    <TextBlock
                        x:Name="TitleText"
                        Text="{Binding Title}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>

            <Border
                DockPanel.Dock="Bottom"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                CornerRadius="0,0,6,6"
            >
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button
                            x:Name="OkButton"
                            Style="{StaticResource GhAccentButton}"
                            Width="75"
                            Margin="0,0,8,0"
                            Content="OK"
                            IsDefault="True"
                            IsEnabled="{Binding CanApply}"
                            Click="OnOk"
                        />
                        <Button
                            x:Name="CancelButton"
                            Style="{StaticResource GhDialogButton}"
                            Width="75"
                            Content="Cancel"
                            IsCancel="True"
                            Click="OnCancel"
                        />
                    </StackPanel>
                    <TextBlock
                        Foreground="{StaticResource GhTextMuted}"
                        VerticalAlignment="Center"
                        Text="OK applies every value at once."
                    />
                </DockPanel>
            </Border>

            <StackPanel Margin="16,12">
                <TextBlock
                    x:Name="DescriptionText"
                    Text="{Binding Description}"
                    Foreground="{StaticResource GhTextMuted}"
                    Margin="0,0,0,6"
                    TextWrapping="Wrap"
                />
                <ItemsControl x:Name="SettingRows" ItemsSource="{Binding Rows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:PluginSettingRow}">
                            <Border BorderBrush="{StaticResource GhHeader}" BorderThickness="0,1,0,0" Padding="0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Text="{Binding Label}"
                                        Margin="0,4,12,0"
                                        TextTrimming="CharacterEllipsis"
                                    />
                                    <StackPanel Grid.Column="1">
                                        <Border x:Name="TextBox" Style="{StaticResource Box}">
                                            <TextBox
                                                Style="{StaticResource GhTextBox}"
                                                FontFamily="{StaticResource GhMonoFont}"
                                                Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                AutomationProperties.Name="{Binding Label}"
                                            />
                                        </Border>
                                        <CheckBox
                                            x:Name="Check"
                                            Style="{StaticResource GhCheckBox}"
                                            Margin="0,4"
                                            HorizontalAlignment="Left"
                                            IsChecked="{Binding IsChecked}"
                                            AutomationProperties.Name="{Binding Label}"
                                            Visibility="Collapsed"
                                        />
                                        <ComboBox
                                            x:Name="Choice"
                                            Style="{StaticResource GhComboBox}"
                                            Width="180"
                                            HorizontalAlignment="Left"
                                            ItemsSource="{Binding Choices}"
                                            SelectedItem="{Binding Choice}"
                                            AutomationProperties.Name="{Binding Label}"
                                            Visibility="Collapsed"
                                        />
                                        <TextBlock
                                            Style="{StaticResource Small}"
                                            Foreground="{StaticResource GhTextMuted}"
                                            Text="{Binding Hint}"
                                        />
                                        <TextBlock
                                            x:Name="Refusal"
                                            Style="{StaticResource Small}"
                                            Foreground="{StaticResource Refused}"
                                            Text="{Binding Error}"
                                            Visibility="Collapsed"
                                        />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsCheck}" Value="True">
                                    <Setter TargetName="TextBox" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsChoice}" Value="True">
                                    <Setter TargetName="TextBox" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Choice" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter TargetName="Refusal" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
