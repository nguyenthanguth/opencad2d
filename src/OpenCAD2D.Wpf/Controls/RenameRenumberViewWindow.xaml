<Window
    x:Class="OpenCAD2D.Wpf.RenameRenumberViewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Rename &amp; Renumber View"
    Width="470"
    Height="224"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OpenCAD2D.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/OpenCAD2D.Wpf;component/Themes/StyleDialogs.xaml" />
                <ResourceDictionary Source="/OpenCAD2D.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="ViewError" Color="#FF8A7A" />
        </ResourceDictionary>
    </Window.Resources>

    <!-- Design A12SsmSheetViews, state 5: the number and the title of one view, with Previous and Next to walk the views. -->
    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnCancel"
                        ToolTip="Close"
                    />
                    <TextBlock
                        Text="Rename &amp; Renumber View"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button
                            Style="{StaticResource StylePrimaryButton}"
                            Content="OK"
                            Padding="18,5"
                            Margin="0,0,8,0"
                            IsDefault="True"
                            IsEnabled="{Binding CanOk}"
                            Click="OnOk"
                        />
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="Cancel"
                            Padding="14,5"
                            Margin="0,0,8,0"
                            IsCancel="True"
                            Click="OnCancel"
                        />
                        <Button Style="{StaticResource GhDialogButton}" Content="Help" Padding="14,5" Click="OnHelp" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="&lt; Previous"
                            Padding="12,5"
                            Margin="0,0,8,0"
                            IsEnabled="{Binding CanPrevious}"
                            Click="OnPrevious"
                        />
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="Next &gt;"
                            Padding="12,5"
                            IsEnabled="{Binding CanNext}"
                            Click="OnNext"
                        />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Margin="16,14,16,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Number:" VerticalAlignment="Center" />
                <TextBox
                    x:Name="NumberBox"
                    Grid.Column="1"
                    Style="{StaticResource BlockBox}"
                    Width="80"
                    HorizontalAlignment="Left"
                    Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}"
                    AutomationProperties.Name="Number"
                />
                <TextBlock Grid.Row="2" Text="View title:" VerticalAlignment="Center" />
                <TextBox
                    Grid.Row="2"
                    Grid.Column="1"
                    Style="{StaticResource BlockBox}"
                    Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                    AutomationProperties.Name="View title"
                />
                <TextBlock
                    Grid.Row="3"
                    Grid.ColumnSpan="2"
                    Margin="0,10,0,0"
                    TextWrapping="Wrap"
                    AutomationProperties.Name="Info"
                >
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding Info}" />
                            <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanOk}" Value="False">
                                    <Setter Property="Text" Value="{Binding Error}" />
                                    <Setter Property="Foreground" Value="{StaticResource ViewError}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DockPanel>
    </Border>
</Window>
