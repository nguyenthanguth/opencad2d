<Window
    x:Class="OpenCAD2D.Wpf.ShareDownloadWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:OpenCAD2D.Wpf"
    Title="Download from Share"
    Width="760"
    SizeToContent="Height"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OpenCAD2D.Wpf;component/Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="Show" />
            <Style x:Key="Key" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>
            <Style x:Key="Value" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="Mono" TargetType="TextBlock" BasedOn="{StaticResource Value}">
                <Setter Property="FontFamily" Value="{StaticResource GhMonoFont}" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        CornerRadius="6"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                CornerRadius="6,6,0,0"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnClose"
                        ToolTip="Close"
                    />
                    <TextBlock
                        Text="Download from Share"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>

            <Border
                DockPanel.Dock="Bottom"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                CornerRadius="0,0,6,6"
            >
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button
                            x:Name="DownloadButton"
                            Style="{StaticResource GhAccentButton}"
                            Padding="14,5"
                            MinWidth="75"
                            Margin="0,0,8,0"
                            Content="{Binding DownloadLabel}"
                            Command="{Binding DownloadCommand}"
                        />
                        <Button
                            x:Name="CloseButton"
                            Style="{StaticResource GhCloseButton}"
                            Padding="14,5"
                            MinWidth="75"
                            Content="Close"
                            Click="OnClose"
                            IsCancel="True"
                        />
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center">
                        <Hyperlink x:Name="BrowseLink" Command="{Binding BrowseCommand}">
                            Browse Share in the browser
                        </Hyperlink>
                    </TextBlock>
                </DockPanel>
            </Border>

            <StackPanel Margin="16,14">
                <TextBlock Text="Paste the link of a tool from opencad2d.com/share" />
                <DockPanel Margin="0,6,0,0">
                    <Button
                        x:Name="FindButton"
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhDialogButton}"
                        Padding="14,5"
                        MinWidth="75"
                        Margin="8,0,0,0"
                        Content="Find"
                        Command="{Binding FindCommand}"
                    />
                    <TextBox
                        x:Name="LinkBox"
                        Style="{StaticResource GhTextBox}"
                        FontFamily="{StaticResource GhMonoFont}"
                        Text="{Binding Link, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="Link of the tool"
                    >
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding FindCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>

                <StackPanel x:Name="Details" Visibility="{Binding Found, Converter={StaticResource Show}}">
                    <Border
                        Margin="0,14,0,0"
                        Padding="14"
                        Background="{StaticResource GhInput}"
                        BorderBrush="{StaticResource GhBorder}"
                        BorderThickness="1"
                    >
                        <DockPanel>
                            <Image
                                x:Name="Cover"
                                DockPanel.Dock="Left"
                                Width="220"
                                Height="138"
                                Margin="0,0,16,0"
                                Stretch="UniformToFill"
                                VerticalAlignment="Top"
                                AutomationProperties.Name="{Binding Title}"
                            />
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Summary}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        Style="{StaticResource Key}"
                                        Text="Type"
                                        Margin="0,0,14,4"
                                    />
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Style="{StaticResource Value}"
                                        Text="{Binding TypeText}"
                                        Margin="0,0,0,4"
                                    />
                                    <TextBlock
                                        Grid.Row="1"
                                        Style="{StaticResource Key}"
                                        Text="Version"
                                        Margin="0,0,14,4"
                                    />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Style="{StaticResource Value}"
                                        Text="{Binding VersionText}"
                                        Margin="0,0,0,4"
                                    />
                                    <TextBlock
                                        Grid.Row="2"
                                        Style="{StaticResource Key}"
                                        Text="SHA-256"
                                        Margin="0,0,14,4"
                                    />
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Style="{StaticResource Mono}"
                                        Text="{Binding ShaText}"
                                        Margin="0,0,0,4"
                                    />
                                    <TextBlock
                                        Grid.Row="3"
                                        Style="{StaticResource Key}"
                                        Text="On this PC"
                                        Margin="0,0,14,4"
                                    />
                                    <TextBlock
                                        x:Name="OnThisPc"
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Style="{StaticResource Value}"
                                        Text="{Binding OnThisPcText}"
                                        Margin="0,0,0,4"
                                    />
                                    <TextBlock
                                        Grid.Row="4"
                                        Style="{StaticResource Key}"
                                        Text="Review"
                                        Margin="0,0,14,4"
                                    />
                                    <TextBlock
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Style="{StaticResource Value}"
                                        Foreground="{StaticResource GhOk}"
                                        Text="{Binding ReviewText}"
                                        Margin="0,0,0,4"
                                    />
                                    <TextBlock
                                        Grid.Row="5"
                                        Style="{StaticResource Key}"
                                        Text="Adds"
                                        Margin="0,0,14,4"
                                    />
                                    <TextBlock
                                        Grid.Row="5"
                                        Grid.Column="1"
                                        Style="{StaticResource Mono}"
                                        Text="{Binding CommandsText}"
                                        Margin="0,0,0,4"
                                    />
                                    <TextBlock
                                        Grid.Row="6"
                                        Style="{StaticResource Key}"
                                        Text="File"
                                        Margin="0,0,14,0"
                                    />
                                    <TextBlock
                                        Grid.Row="6"
                                        Grid.Column="1"
                                        Style="{StaticResource Value}"
                                        Text="{Binding FileText}"
                                    />
                                </Grid>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Save to" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <DockPanel Grid.Column="1">
                            <Button
                                x:Name="ChooseFolderButton"
                                DockPanel.Dock="Right"
                                Style="{StaticResource GhDialogButton}"
                                Padding="10,4"
                                Margin="8,0,0,0"
                                Content="…"
                                Command="{Binding ChooseFolderCommand}"
                                ToolTip="Choose the folder the tool's own folder is made in"
                                AutomationProperties.Name="Choose the folder"
                            />
                            <TextBox
                                x:Name="SaveToBox"
                                Style="{StaticResource GhTextBox}"
                                FontFamily="{StaticResource GhMonoFont}"
                                IsReadOnly="True"
                                Text="{Binding SaveTo, Mode=OneWay}"
                                AutomationProperties.Name="Save to"
                            />
                        </DockPanel>
                        <CheckBox
                            x:Name="LoadNowBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource GhCheckBox}"
                            Margin="0,10,0,0"
                            Content="Load it now, and at every start"
                            IsChecked="{Binding LoadNow, Mode=TwoWay}"
                        />
                    </Grid>
                </StackPanel>

                <Border
                    x:Name="ResultLine"
                    Margin="0,14,0,0"
                    Padding="12,10"
                    BorderThickness="1"
                    Visibility="{Binding HasResult, Converter={StaticResource Show}}"
                >
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#1F3A26" />
                            <Setter Property="BorderBrush" Value="{StaticResource GhOk}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ResultIsError}" Value="True">
                                    <Setter Property="Background" Value="#43201C" />
                                    <Setter Property="BorderBrush" Value="{StaticResource GhProblem}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock x:Name="ResultText" Text="{Binding Result}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
