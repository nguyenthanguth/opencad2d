<Window
    x:Class="OpenCAD2D.Wpf.SheetImportOptionsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:OpenCAD2D.Wpf"
    Title="Import Options"
    Width="380"
    Height="226"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OpenCAD2D.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/OpenCAD2D.Wpf;component/Themes/StyleDialogs.xaml" />
                <ResourceDictionary Source="/OpenCAD2D.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Design A12WizardDrawings, state 4: the three boxes of Import Options; Ignore top level folder is nested under the subsets box. -->
    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,10"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Command="{Binding CancelCommand}"
                        ToolTip="Close"
                    />
                    <TextBlock Text="Import Options" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button
                        Style="{StaticResource StylePrimaryButton}"
                        Content="OK"
                        Padding="14,5"
                        MinWidth="75"
                        Margin="0,0,8,0"
                        Command="{Binding OkCommand}"
                        IsDefault="True"
                    />
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="Cancel"
                        Padding="14,5"
                        MinWidth="75"
                        Margin="0,0,8,0"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"
                    />
                    <Button
                        Style="{StaticResource GhDialogButton}"
                        Content="Help"
                        Padding="14,5"
                        MinWidth="75"
                        Command="{Binding HelpCommand}"
                    />
                </StackPanel>
            </Border>

            <StackPanel Margin="16,14,16,10">
                <CheckBox
                    Style="{StaticResource BlockCheck}"
                    Content="Prefix sheet titles with file name"
                    Margin="0,0,0,8"
                    IsChecked="{Binding PrefixTitleWithFileName, Mode=TwoWay}"
                />
                <CheckBox
                    Style="{StaticResource BlockCheck}"
                    Content="Create subsets based on folder structure"
                    Margin="0,0,0,8"
                    IsChecked="{Binding CreateSubsetsFromFolders, Mode=TwoWay}"
                />
                <CheckBox
                    Style="{StaticResource BlockCheck}"
                    Content="Ignore top level folder"
                    Margin="21,0,0,10"
                    IsEnabled="{Binding CanIgnoreTopLevelFolder}"
                    IsChecked="{Binding IgnoreTopLevelFolder, Mode=TwoWay}"
                />
                <TextBlock
                    Text="{Binding Note}"
                    FontSize="11"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource GhTextMuted}"
                />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
