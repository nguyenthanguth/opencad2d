<Window
    x:Class="OpenCAD2D.Wpf.SheetSetManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:OpenCAD2D.Wpf"
    Title="Sheet Set Manager"
    Width="320"
    Height="760"
    MinWidth="260"
    MinHeight="420"
    WindowStyle="None"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OpenCAD2D.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:BoolToVisibilityConverter x:Key="HiddenWhen" Invert="True" />
            <SolidColorBrush x:Key="SsmDisabled" Color="#6B7480" />
            <SolidColorBrush x:Key="SsmError" Color="#FF8A7A" />

            <!-- A tab of the three under the control: its words, a blue line under the one shown. -->
            <Style x:Key="SsmTab" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border
                                x:Name="Line"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                Padding="0,5"
                            >
                                <ContentPresenter HorizontalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter
                                        TargetName="Line"
                                        Property="BorderBrush"
                                        Value="{StaticResource GhAccent}"
                                    />
                                    <Setter Property="Foreground" Value="{StaticResource GhText}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource GhText}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A button of the toolbar: a picture, with an arrow where it opens a list; faded where it is off. -->
            <Style x:Key="SsmTool" TargetType="Button">
                <Setter Property="Height" Value="24" />
                <Setter Property="Padding" Value="4,0" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Chrome"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                            >
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter
                                        TargetName="Chrome"
                                        Property="Background"
                                        Value="{StaticResource GhHover}"
                                    />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Chrome" Property="Opacity" Value="0.35" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Details and Preview, the two-way switch under the splitter. -->
            <Style x:Key="SsmSwitch" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Pill" Background="Transparent" CornerRadius="3" Padding="10,2">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter
                                        TargetName="Pill"
                                        Property="Background"
                                        Value="{StaticResource GhSelected}"
                                    />
                                    <Setter Property="Foreground" Value="{StaticResource GhText}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A row of the tree: 22 high, selected in the blue of the window's selections, the words in the colour of its state. -->
            <Style x:Key="SsmRow" TargetType="ListBoxItem">
                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                <Setter Property="Foreground" Value="{StaticResource GhText}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Row" Height="22" Background="Transparent" Padding="4,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="{Binding Indent}" />
                                    <local:SheetSetIcon
                                        x:Name="Chevron"
                                        Size="12"
                                        Glyph="{Binding Chevron}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,4,0"
                                    />
                                    <local:SheetSetIcon
                                        Glyph="{Binding Icon}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,4,0"
                                    />
                                    <TextBlock
                                        x:Name="Words"
                                        Text="{Binding Text}"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                    />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsExpandable}" Value="False">
                                    <Setter TargetName="Chevron" Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSheetSet}" Value="True">
                                    <Setter TargetName="Words" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="Muted">
                                    <Setter
                                        TargetName="Words"
                                        Property="Foreground"
                                        Value="{StaticResource SsmDisabled}"
                                    />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="Error">
                                    <Setter
                                        TargetName="Words"
                                        Property="Foreground"
                                        Value="{StaticResource SsmError}"
                                    />
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource GhHover}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter
                                        TargetName="Row"
                                        Property="Background"
                                        Value="{StaticResource GhSelected}"
                                    />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="120" />
                <RowDefinition x:Name="SplitterRow" Height="Auto" />
                <RowDefinition x:Name="PaneRow" Height="230" MinHeight="70" />
            </Grid.RowDefinitions>

            <!-- The title bar: the name, and the cross that closes it (SHEETSETHIDE). -->
            <Border
                Grid.Row="0"
                Background="{StaticResource GhHeader}"
                Padding="12,8"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnClose"
                        ToolTip="Close (SHEETSETHIDE)"
                    />
                    <TextBlock
                        Text="Sheet Set Manager"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>

            <!-- The sheet set control: the set current, its lock, and the arrow that opens the list of sets. -->
            <Border Grid.Row="1" Padding="8,8,8,6">
                <Border
                    x:Name="Control"
                    Height="28"
                    Background="{StaticResource GhInput}"
                    BorderBrush="{StaticResource GhBorder}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8,0"
                    Cursor="Hand"
                    MouseLeftButtonDown="OnControlDown"
                >
                    <DockPanel>
                        <local:SheetSetIcon
                            DockPanel.Dock="Right"
                            Size="12"
                            Glyph="chevron-down"
                            VerticalAlignment="Center"
                        />
                        <local:SheetSetIcon
                            x:Name="LockIcon"
                            DockPanel.Dock="Left"
                            Glyph="lock"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0"
                            Visibility="{Binding IsLocked, Converter={StaticResource Shown}}"
                            ToolTip="{Binding LockToolTip}"
                        />
                        <TextBlock
                            x:Name="ControlWords"
                            Text="{Binding ControlText}"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                        >
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource GhText}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSet}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                </Border>
            </Border>

            <!-- The tabs. -->
            <Grid Grid.Row="2" Margin="8,0" Background="Transparent">
                <Border BorderBrush="{StaticResource GhBorder}" BorderThickness="0,0,0,1" />
                <UniformGrid Rows="1">
                    <RadioButton
                        x:Name="SheetListTab"
                        Style="{StaticResource SsmTab}"
                        GroupName="SsmTabs"
                        Content="Sheet List"
                        IsChecked="True"
                        Checked="OnTab"
                    />
                    <RadioButton
                        x:Name="SheetViewsTabButton"
                        Style="{StaticResource SsmTab}"
                        GroupName="SsmTabs"
                        Content="Sheet Views"
                        Checked="OnTab"
                    />
                    <RadioButton
                        x:Name="ModelViewsTabButton"
                        Style="{StaticResource SsmTab}"
                        GroupName="SsmTabs"
                        Content="Model Views"
                        Checked="OnTab"
                    />
                </UniformGrid>
            </Grid>

            <!-- The toolbar of the Sheet List tab: Publish to PDF, Publish to Plotter, the two lists. -->
            <Border
                Grid.Row="3"
                BorderBrush="{StaticResource GhBorder}"
                BorderThickness="0,0,0,1"
                Padding="8,4"
                IsEnabled="{Binding HasSet}"
                Visibility="{Binding IsSheetListTab, Converter={StaticResource Shown}}"
            >
                <StackPanel Orientation="Horizontal">
                    <Button
                        Style="{StaticResource SsmTool}"
                        Click="OnPublishPdf"
                        ToolTip="Publish to PDF"
                        AutomationProperties.Name="Publish to PDF"
                    >
                        <local:SheetSetIcon Glyph="pdf" />
                    </Button>
                    <Button
                        Style="{StaticResource SsmTool}"
                        Click="OnPublishPlotter"
                        ToolTip="Publish to Plotter"
                        AutomationProperties.Name="Publish to Plotter"
                    >
                        <local:SheetSetIcon Glyph="plotter" />
                    </Button>
                    <Button
                        Style="{StaticResource SsmTool}"
                        Click="OnPublishOverride"
                        ToolTip="Publish Using Page Setup Override"
                        AutomationProperties.Name="Publish Using Page Setup Override"
                    >
                        <StackPanel Orientation="Horizontal">
                            <local:SheetSetIcon Glyph="override" Margin="0,0,2,0" />
                            <local:SheetSetIcon Glyph="chevron-down" Size="12" />
                        </StackPanel>
                    </Button>
                    <Button
                        Style="{StaticResource SsmTool}"
                        Click="OnPublishMenu"
                        ToolTip="Publish"
                        AutomationProperties.Name="Publish"
                    >
                        <StackPanel Orientation="Horizontal">
                            <local:SheetSetIcon Glyph="publish" Margin="0,0,2,0" />
                            <local:SheetSetIcon Glyph="chevron-down" Size="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- The body: the tree of the set, or what stands in its place. -->
            <Grid Grid.Row="4">
                <ListBox
                    x:Name="Tree"
                    ItemsSource="{Binding Rows}"
                    ItemContainerStyle="{StaticResource SsmRow}"
                    SelectionMode="Extended"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0,4"
                    AllowDrop="True"
                    Visibility="{Binding ShowTree, Converter={StaticResource Shown}}"
                    PreviewMouseLeftButtonDown="OnTreeMouseDown"
                    PreviewMouseMove="OnTreeMouseMove"
                    MouseDoubleClick="OnTreeDoubleClick"
                    PreviewMouseRightButtonDown="OnTreeRightDown"
                    ContextMenuOpening="OnTreeMenuOpening"
                    DragOver="OnTreeDragOver"
                    DragLeave="OnTreeDragLeave"
                    Drop="OnTreeDrop"
                    PreviewKeyDown="OnTreeKeyDown"
                />
                <TextBlock
                    x:Name="Hint"
                    Text="{Binding HintText}"
                    Foreground="{StaticResource SsmDisabled}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    LineHeight="18"
                    Margin="16,24"
                    VerticalAlignment="Top"
                    Visibility="{Binding ShowTree, Converter={StaticResource HiddenWhen}}"
                />
                <Border
                    x:Name="DropLine"
                    Height="2"
                    Background="{StaticResource GhAccent}"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Stretch"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"
                />
            </Grid>

            <!-- The body of the Sheet Views or Model Views tab, its toolbar and tree, made when the tab is first shown. -->
            <Grid
                x:Name="TabHost"
                Grid.Row="3"
                Grid.RowSpan="2"
                Background="{StaticResource GhPanel}"
                Visibility="{Binding ShowTabBody, Converter={StaticResource Shown}}"
            />

            <GridSplitter
                x:Name="PaneSplitter"
                Grid.Row="5"
                Height="5"
                HorizontalAlignment="Stretch"
                ResizeDirection="Rows"
                ResizeBehavior="PreviousAndNext"
                Background="{StaticResource GhHeader}"
                BorderBrush="{StaticResource GhBorder}"
                BorderThickness="0,1,0,1"
                Cursor="SizeNS"
            />

            <!-- Details and Preview of what is selected. -->
            <DockPanel x:Name="Pane" Grid.Row="6" Background="{StaticResource GhPanel}">
                <Border DockPanel.Dock="Top" Background="{StaticResource GhHeader}" Padding="8,4">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton
                            Style="{StaticResource SsmSwitch}"
                            GroupName="SsmPane"
                            Content="Details"
                            IsChecked="{Binding ShowDetails, Mode=OneWay}"
                            Checked="OnDetails"
                        />
                        <RadioButton
                            x:Name="PreviewSwitch"
                            Style="{StaticResource SsmSwitch}"
                            GroupName="SsmPane"
                            Content="Preview"
                            IsChecked="{Binding ShowPreview, Mode=OneWay}"
                            Checked="OnPreview"
                        />
                    </StackPanel>
                </Border>
                <Grid>
                    <ItemsControl
                        x:Name="DetailRows"
                        ItemsSource="{Binding Details}"
                        Margin="10,8"
                        FontSize="11"
                        Visibility="{Binding ShowDetails, Converter={StaticResource Shown}}"
                    >
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource GhTextMuted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource GhText}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tone}" Value="Ok">
                                                        <Setter Property="Foreground" Value="{StaticResource GhOk}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Tone}" Value="Warn">
                                                        <Setter Property="Foreground" Value="#E3B341" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Tone}" Value="Error">
                                                        <Setter
                                                            Property="Foreground"
                                                            Value="{StaticResource SsmError}"
                                                        />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border
                        Margin="8"
                        Background="White"
                        Visibility="{Binding HasPreview, Converter={StaticResource Shown}}"
                    >
                        <Image Source="{Binding Preview}" Stretch="Uniform" />
                    </Border>
                    <TextBlock
                        Text="No picture of this."
                        Foreground="{StaticResource GhTextMuted}"
                        FontSize="11"
                        Margin="10,8"
                        Visibility="{Binding NoPreview, Converter={StaticResource Shown}}"
                    />
                </Grid>
            </DockPanel>
        </Grid>
    </Border>
</Window>
