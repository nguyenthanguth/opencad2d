<local:SheetSetDialogWindow
    x:Class="OpenCAD2D.Wpf.SheetSetPropertiesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:OpenCAD2D.Wpf"
    Title="{Binding Title}"
    Style="{DynamicResource SheetSetWindow}"
    WindowStartupLocation="CenterOwner"
    Width="585"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OpenCAD2D.Wpf;component/Themes/SheetSetDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A set and a subset add nothing under the grid. -->
            <DataTemplate DataType="{x:Type local:SheetSetGridViewModel}">
                <Border Height="0" />
            </DataTemplate>

            <!-- What a sheet adds under its grid: why its layout is not found, and the Rename Options. -->
            <DataTemplate DataType="{x:Type local:SheetSetSheetPropertiesViewModel}">
                <StackPanel>
                    <Border
                        Style="{StaticResource SheetSetErrorBox}"
                        Visibility="{Binding HasProblem, Converter={StaticResource SheetSetShown}}"
                    >
                        <TextBlock x:Name="Problem" Text="{Binding Problem}" TextWrapping="Wrap" />
                    </Border>
                    <HeaderedContentControl
                        Header="Rename Options"
                        Style="{StaticResource UcsGroup}"
                        Margin="0,10,0,0"
                        IsEnabled="{Binding CanEditRenameOptions}"
                    >
                        <StackPanel>
                            <CheckBox
                                Style="{StaticResource SheetSetCheck}"
                                Content="Rename layout to match sheet title"
                                IsChecked="{Binding RenameLayout}"
                            />
                            <CheckBox
                                Style="{StaticResource SheetSetCheck}"
                                Margin="22,0,0,6"
                                Content="Prefix with sheet number"
                                IsChecked="{Binding PrefixLayoutWithNumber}"
                                IsEnabled="{Binding CanEditPrefixLayout}"
                            />
                            <CheckBox
                                Style="{StaticResource SheetSetCheck}"
                                Content="Rename drawing file to match sheet title"
                                IsChecked="{Binding RenameFile}"
                            />
                            <CheckBox
                                Style="{StaticResource SheetSetCheck}"
                                Margin="22,0,0,0"
                                Content="Prefix with sheet number"
                                IsChecked="{Binding PrefixFileWithNumber}"
                                IsEnabled="{Binding CanEditPrefixFile}"
                            />
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <local:SheetSetDialogFrame
        x:Name="Frame"
        Style="{StaticResource SheetSetFrame}"
        Title="{Binding Title}"
        OkEnabled="{Binding CanApply}"
        IsReadOnlyMode="{Binding IsReadOnly}"
    >
        <StackPanel Margin="16,12">
            <Border
                Style="{StaticResource SheetSetNoticeBox}"
                Margin="0,0,0,8"
                Visibility="{Binding IsReadOnly, Converter={StaticResource SheetSetShown}}"
            >
                <TextBlock Text="{Binding ReadOnlyNotice}" TextWrapping="Wrap" />
            </Border>
            <local:SheetSetPropertyGrid x:Name="Grid" MaxRowsHeight="580" />
            <Border
                Style="{StaticResource SheetSetErrorBox}"
                Visibility="{Binding HasError, Converter={StaticResource SheetSetShown}}"
            >
                <TextBlock x:Name="ErrorText" Text="{Binding Error}" TextWrapping="Wrap" />
            </Border>
            <ContentControl Content="{Binding}" Focusable="False" />
            <Border
                x:Name="DescriptionPane"
                Margin="0,10,0,0"
                Padding="10,7"
                Background="{StaticResource GhInput}"
                BorderBrush="{StaticResource GhBorder}"
                BorderThickness="1"
                CornerRadius="3"
                Visibility="{Binding HasDescriptionPane, Converter={StaticResource SheetSetShown}}"
            >
                <StackPanel>
                    <TextBlock Text="{Binding DescriptionTitle}" FontWeight="SemiBold" />
                    <TextBlock
                        Text="{Binding DescriptionText}"
                        Foreground="{StaticResource GhTextMuted}"
                        FontSize="11"
                        TextWrapping="Wrap"
                        MinHeight="30"
                    />
                </StackPanel>
            </Border>
        </StackPanel>
    </local:SheetSetDialogFrame>
</local:SheetSetDialogWindow>
