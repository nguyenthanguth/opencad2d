<UserControl
    x:Class="OpenCAD2D.Wpf.SheetSetPropertyGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:OpenCAD2D.Wpf"
    Focusable="False"
>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OpenCAD2D.Wpf;component/Themes/SheetSetDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- The rows of a property grid of the sheet set dialogs: a heading (with its chevron) groups the rows under it, a row is
         a label and a value that is typed, chosen or picked by its ... button; the row clicked is accent-coloured. -->
    <Border
        Background="{StaticResource GhInput}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        CornerRadius="3"
    >
        <ScrollViewer
            x:Name="Scroller"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            Focusable="False"
        >
            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:SheetSetGridRow}">
                        <Grid>
                            <Border
                                x:Name="Section"
                                Visibility="Collapsed"
                                Background="{StaticResource GhHeader}"
                                BorderBrush="{StaticResource GhBorder}"
                                BorderThickness="0,0,0,1"
                                Padding="10,5"
                            >
                                <StackPanel Orientation="Horizontal">
                                    <Path
                                        Data="M1,2 L5,6 L9,2"
                                        Stroke="{StaticResource GhTextMuted}"
                                        StrokeThickness="1.4"
                                        Width="10"
                                        Height="8"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                    />
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border
                                x:Name="Line"
                                MinHeight="23"
                                BorderBrush="{StaticResource GhBorder}"
                                BorderThickness="0,0,0,1"
                                Background="Transparent"
                            >
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="LabelText"
                                        Text="{Binding Label}"
                                        Margin="10,0,6,0"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                    />
                                    <Border
                                        Grid.Column="1"
                                        BorderBrush="{StaticResource GhBorder}"
                                        BorderThickness="1,0,0,0"
                                    >
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button
                                                x:Name="Dots"
                                                Grid.Column="1"
                                                Style="{StaticResource SheetSetDots}"
                                                Height="18"
                                                Margin="2,0,4,0"
                                                Visibility="Collapsed"
                                                Click="OnDots"
                                                ToolTip="Choose..."
                                            />
                                            <ComboBox
                                                x:Name="Choice"
                                                Margin="2,1"
                                                Style="{StaticResource GhComboBox}"
                                                ItemsSource="{Binding Choices}"
                                                SelectedItem="{Binding Text}"
                                                IsEnabled="{Binding IsReadOnly, Converter={StaticResource SheetSetHidden}}"
                                                Visibility="Collapsed"
                                                AutomationProperties.Name="{Binding Label}"
                                            />
                                            <TextBox
                                                x:Name="Box"
                                                Style="{StaticResource GhTextBox}"
                                                Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                IsReadOnly="{Binding IsReadOnly}"
                                                Padding="6,3"
                                                AutomationProperties.Name="{Binding Label}"
                                            />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSection}" Value="True">
                                <Setter TargetName="Section" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Line" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsChoice}" Value="True">
                                <Setter TargetName="Choice" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Box" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                <Setter TargetName="Choice" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Box" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasButton}" Value="True">
                                <Setter TargetName="Dots" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                <Setter
                                    TargetName="LabelText"
                                    Property="Foreground"
                                    Value="{StaticResource GhTextMuted}"
                                />
                                <Setter TargetName="Box" Property="Foreground" Value="{StaticResource GhTextMuted}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsRed}" Value="True">
                                <Setter TargetName="Box" Property="Foreground" Value="{StaticResource SheetSetRed}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter
                                    TargetName="Line"
                                    Property="Background"
                                    Value="{StaticResource SheetSetRedGround}"
                                />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Line" Property="Background" Value="{StaticResource GhSelected}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Border>
</UserControl>
