<UserControl
    x:Class="OpenCAD2D.Wpf.StylePreviewPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:OpenCAD2D.Wpf"
>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OpenCAD2D.Wpf;component/Themes/StyleDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A swatch of the toolbar: a ground to choose, ringed in the accent while chosen. -->
            <Style x:Key="GroundSwatch" TargetType="RadioButton">
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="22" />
                <Setter Property="Margin" Value="6,0,0,0" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border
                                x:Name="Ring"
                                BorderBrush="{StaticResource GhBorder}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Background="Transparent"
                            >
                                <Border
                                    Width="12"
                                    Height="12"
                                    BorderBrush="#5B6573"
                                    BorderThickness="1"
                                    Background="{TemplateBinding Background}"
                                />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter
                                        TargetName="Ring"
                                        Property="BorderBrush"
                                        Value="{StaticResource GhAccent}"
                                    />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel x:Name="Root">
        <!-- The title row: the title on the left, the toolbar (Fit, the zoom in percent of Fit, the grounds) on the right. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" Height="24">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button
                    x:Name="FitButton"
                    Style="{StaticResource GhDialogButton}"
                    Content="Fit"
                    Padding="8,2"
                    ToolTip="Show the whole sample (double click)"
                />
                <TextBlock
                    x:Name="ZoomText"
                    Margin="8,0,0,0"
                    MinWidth="40"
                    VerticalAlignment="Center"
                    TextAlignment="Right"
                    Foreground="{StaticResource GhTextMuted}"
                    ToolTip="Zoom, in percent of Fit; the wheel zooms about the pointer"
                />
                <RadioButton
                    x:Name="BlackGround"
                    Style="{StaticResource GroundSwatch}"
                    Background="Black"
                    GroupName="PreviewGround"
                    ToolTip="Black ground"
                />
                <RadioButton
                    x:Name="WhiteGround"
                    Style="{StaticResource GroundSwatch}"
                    Background="White"
                    GroupName="PreviewGround"
                    ToolTip="White ground"
                />
            </StackPanel>
            <TextBlock
                x:Name="TitleText"
                FontSize="13"
                FontWeight="SemiBold"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis"
            />
        </DockPanel>
        <Border x:Name="Frame" Style="{StaticResource StylePreview}">
            <local:StylePreviewView x:Name="View" />
        </Border>
    </DockPanel>
</UserControl>
