<UserControl
    x:Class="OpenCAD2D.Wpf.TableCellRibbon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:OpenCAD2D.Wpf"
>
    <!--
    The contextual Table Cell tab, as the design draws it: Rows, Columns, Merge, Cell Styles, Cell Format, Insert and Data. Its
    logic is TableCellViewModel. The ribbon's styles are the workspace's, found at run time (DynamicResource); what is not built
    is greyed with its reason, as BigButton and SmallButton grey a button by default.
    -->
    <UserControl.Resources>
        <local:RgbBrushConverter x:Key="FillBrush" />
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal">
        <Border Style="{DynamicResource GroupBorder}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Style="{DynamicResource GroupTitle}" Text="Rows" />
                <StackPanel Orientation="Horizontal">
                    <Button
                        Style="{DynamicResource BigButton}"
                        Tag="{DynamicResource IconInsertAbove.Color}"
                        Content="Insert Above"
                        IsEnabled="True"
                        Command="{Binding InsertAboveCommand}"
                        ToolTip="Insert a row above"
                    />
                    <Button
                        Style="{DynamicResource BigButton}"
                        Tag="{DynamicResource IconInsertBelow.Color}"
                        Content="Insert Below"
                        IsEnabled="True"
                        Command="{Binding InsertBelowCommand}"
                        ToolTip="Insert a row below"
                    />
                    <Button
                        Style="{DynamicResource BigButton}"
                        Tag="{DynamicResource IconDeleteRows.Color}"
                        Content="Delete Row(s)"
                        IsEnabled="True"
                        Command="{Binding DeleteRowsCommand}"
                        ToolTip="Delete the rows selected"
                        Margin="0"
                    />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Style="{DynamicResource GroupBorder}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Style="{DynamicResource GroupTitle}" Text="Columns" />
                <StackPanel Orientation="Horizontal">
                    <Button
                        Style="{DynamicResource BigButton}"
                        Tag="{DynamicResource IconInsertLeft.Color}"
                        Content="Insert Left"
                        IsEnabled="True"
                        Command="{Binding InsertLeftCommand}"
                        ToolTip="Insert a column left"
                    />
                    <Button
                        Style="{DynamicResource BigButton}"
                        Tag="{DynamicResource IconInsertRight.Color}"
                        Content="Insert Right"
                        IsEnabled="True"
                        Command="{Binding InsertRightCommand}"
                        ToolTip="Insert a column right"
                    />
                    <Button
                        Style="{DynamicResource BigButton}"
                        Tag="{DynamicResource IconDeleteColumns.Color}"
                        Content="Delete Column(s)"
                        IsEnabled="True"
                        Command="{Binding DeleteColumnsCommand}"
                        ToolTip="Delete the columns selected"
                        Margin="0"
                    />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Style="{DynamicResource GroupBorder}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Style="{DynamicResource GroupTitle}" Text="Merge" />
                <StackPanel Orientation="Horizontal">
                    <Button
                        Style="{DynamicResource BigButton}"
                        Tag="{DynamicResource IconMerge.Color}"
                        Content="Merge Cells ▾"
                        IsEnabled="{Binding CanMerge}"
                        Click="OnMenu"
                        ToolTip="Merge All, Merge By Row, Merge By Column"
                    >
                        <Button.ContextMenu>
                            <ContextMenu
                                Style="{DynamicResource GhContextMenu}"
                                DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                            >
                                <MenuItem
                                    Style="{DynamicResource GhMenuItem}"
                                    Header="Merge All"
                                    Command="{Binding MergeAllCommand}"
                                />
                                <MenuItem
                                    Style="{DynamicResource GhMenuItem}"
                                    Header="Merge By Row"
                                    Command="{Binding MergeByRowCommand}"
                                />
                                <MenuItem
                                    Style="{DynamicResource GhMenuItem}"
                                    Header="Merge By Column"
                                    Command="{Binding MergeByColumnCommand}"
                                />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button
                        Style="{DynamicResource BigButton}"
                        Tag="{DynamicResource IconUnmerge.Color}"
                        Content="Unmerge Cells"
                        IsEnabled="True"
                        Command="{Binding UnmergeCommand}"
                        ToolTip="Unmerge the cells selected"
                        Margin="0"
                    />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Style="{DynamicResource GroupBorder}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Style="{DynamicResource GroupTitle}" Text="Cell Styles" />
                <StackPanel Orientation="Horizontal">
                    <WrapPanel Style="{DynamicResource SmallColumn}">
                        <Button
                            Style="{DynamicResource SmallButton}"
                            Tag="{DynamicResource IconMatch.Color}"
                            Content="Match Cell"
                            IsEnabled="True"
                            Command="{Binding MatchCellCommand}"
                            ToolTip="Applies the properties of a selected table cell to other table cells (MATCHCELL)"
                        />
                        <Button
                            Style="{DynamicResource SmallButton}"
                            Tag="{DynamicResource IconAlign.Color}"
                            Content="{Binding AlignmentName}"
                            IsEnabled="True"
                            Click="OnMenu"
                            ToolTip="Alignment of the cells selected"
                        >
                            <Button.ContextMenu>
                                <ContextMenu
                                    Style="{DynamicResource GhContextMenu}"
                                    DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                >
                                    <MenuItem
                                        Style="{DynamicResource GhMenuItem}"
                                        Header="Top Left"
                                        Command="{Binding AlignCommand}"
                                        CommandParameter="Top Left"
                                    />
                                    <MenuItem
                                        Style="{DynamicResource GhMenuItem}"
                                        Header="Top Center"
                                        Command="{Binding AlignCommand}"
                                        CommandParameter="Top Center"
                                    />
                                    <MenuItem
                                        Style="{DynamicResource GhMenuItem}"
                                        Header="Top Right"
                                        Command="{Binding AlignCommand}"
                                        CommandParameter="Top Right"
                                    />
                                    <MenuItem
                                        Style="{DynamicResource GhMenuItem}"
                                        Header="Middle Left"
                                        Command="{Binding AlignCommand}"
                                        CommandParameter="Middle Left"
                                    />
                                    <MenuItem
                                        Style="{DynamicResource GhMenuItem}"
                                        Header="Middle Center"
                                        Command="{Binding AlignCommand}"
                                        CommandParameter="Middle Center"
                                    />
                                    <MenuItem
                                        Style="{DynamicResource GhMenuItem}"
                                        Header="Middle Right"
                                        Command="{Binding AlignCommand}"
                                        CommandParameter="Middle Right"
                                    />
                                    <MenuItem
                                        Style="{DynamicResource GhMenuItem}"
                                        Header="Bottom Left"
                                        Command="{Binding AlignCommand}"
                                        CommandParameter="Bottom Left"
                                    />
                                    <MenuItem
                                        Style="{DynamicResource GhMenuItem}"
                                        Header="Bottom Center"
                                        Command="{Binding AlignCommand}"
                                        CommandParameter="Bottom Center"
                                    />
                                    <MenuItem
                                        Style="{DynamicResource GhMenuItem}"
                                        Header="Bottom Right"
                                        Command="{Binding AlignCommand}"
                                        CommandParameter="Bottom Right"
                                    />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button
                            Style="{DynamicResource SmallButton}"
                            Tag="{DynamicResource IconBorders.Color}"
                            Content="Cell Borders ▾"
                            IsEnabled="True"
                            Click="OnMenu"
                            ToolTip="Show or hide lines of the cells selected"
                        >
                            <Button.ContextMenu>
                                <ContextMenu
                                    Style="{DynamicResource GhContextMenu}"
                                    DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                >
                                    <MenuItem
                                        Style="{DynamicResource GhMenuItem}"
                                        Header="All Borders"
                                        Command="{Binding BordersCommand}"
                                        CommandParameter="All"
                                    />
                                    <MenuItem
                                        Style="{DynamicResource GhMenuItem}"
                                        Header="Outside Borders"
                                        Command="{Binding BordersCommand}"
                                        CommandParameter="Outside"
                                    />
                                    <MenuItem
                                        Style="{DynamicResource GhMenuItem}"
                                        Header="Inside Borders"
                                        Command="{Binding BordersCommand}"
                                        CommandParameter="Inside"
                                    />
                                    <MenuItem
                                        Style="{DynamicResource GhMenuItem}"
                                        Header="Bottom Border"
                                        Command="{Binding BordersCommand}"
                                        CommandParameter="Bottom"
                                    />
                                    <MenuItem
                                        Style="{DynamicResource GhMenuItem}"
                                        Header="Left Border"
                                        Command="{Binding BordersCommand}"
                                        CommandParameter="Left"
                                    />
                                    <MenuItem
                                        Style="{DynamicResource GhMenuItem}"
                                        Header="Top Border"
                                        Command="{Binding BordersCommand}"
                                        CommandParameter="Top"
                                    />
                                    <MenuItem
                                        Style="{DynamicResource GhMenuItem}"
                                        Header="Right Border"
                                        Command="{Binding BordersCommand}"
                                        CommandParameter="Right"
                                    />
                                    <MenuItem
                                        Style="{DynamicResource GhMenuItem}"
                                        Header="No Borders"
                                        Command="{Binding BordersCommand}"
                                        CommandParameter="None"
                                    />
                                    <Separator />
                                    <MenuItem
                                        Style="{DynamicResource GhMenuItem}"
                                        Header="Cell Borders…"
                                        Command="{Binding BordersDialogCommand}"
                                    />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </WrapPanel>
                    <StackPanel Width="120" Margin="0,2,0,0">
                        <!-- The cell style of the first cell: the style's cell styles, then the two dialogs. -->
                        <ComboBox
                            Style="{DynamicResource GhComboBox}"
                            ItemsSource="{Binding CellStyleChoices}"
                            SelectedItem="{Binding CellStyle, Mode=TwoWay}"
                            Margin="0,0,0,4"
                            ToolTip="The cell style of the cells selected: Title, Header, Data or one made with Create New Cell Style"
                        />
                        <ComboBox
                            Style="{DynamicResource GhComboBox}"
                            ItemsSource="{Binding FillChoices}"
                            SelectedItem="{Binding Fill, Mode=TwoWay}"
                            ToolTip="Background fill of the cells selected"
                        >
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border
                                            Width="10"
                                            Height="10"
                                            BorderBrush="#5B6573"
                                            BorderThickness="1"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Background="{Binding Rgb, Converter={StaticResource FillBrush}}"
                                        />
                                        <TextBlock Text="{Binding Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Style="{DynamicResource GroupBorder}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Style="{DynamicResource GroupTitle}" Text="Cell Format" />
                <WrapPanel Style="{DynamicResource SmallColumn}">
                    <Button
                        Style="{DynamicResource SmallButton}"
                        Tag="{DynamicResource IconLock.Color}"
                        Content="Cell Locking ▾"
                        IsEnabled="True"
                        Click="OnMenu"
                        ToolTip="Locks the content or the format of the cells selected"
                    >
                        <Button.ContextMenu>
                            <ContextMenu
                                Style="{DynamicResource GhContextMenu}"
                                DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                            >
                                <MenuItem
                                    Style="{DynamicResource GhMenuItem}"
                                    Header="Unlocked"
                                    Command="{Binding LockCommand}"
                                    CommandParameter="Unlocked"
                                />
                                <MenuItem
                                    Style="{DynamicResource GhMenuItem}"
                                    Header="Content Locked"
                                    Command="{Binding LockCommand}"
                                    CommandParameter="Content Locked"
                                />
                                <MenuItem
                                    Style="{DynamicResource GhMenuItem}"
                                    Header="Format Locked"
                                    Command="{Binding LockCommand}"
                                    CommandParameter="Format Locked"
                                />
                                <MenuItem
                                    Style="{DynamicResource GhMenuItem}"
                                    Header="Content and Format Locked"
                                    Command="{Binding LockCommand}"
                                    CommandParameter="Content and Format Locked"
                                />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button
                        Style="{DynamicResource SmallButton}"
                        Tag="{DynamicResource IconFormat.Color}"
                        Content="Data Format ▾"
                        IsEnabled="True"
                        Click="OnMenu"
                        ToolTip="The kind of data and the format of the cells selected"
                    >
                        <Button.ContextMenu>
                            <ContextMenu
                                Style="{DynamicResource GhContextMenu}"
                                DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                            >
                                <MenuItem
                                    Style="{DynamicResource GhMenuItem}"
                                    Header="Angle"
                                    Command="{Binding DataFormatCommand}"
                                    CommandParameter="Angle"
                                />
                                <MenuItem
                                    Style="{DynamicResource GhMenuItem}"
                                    Header="Currency"
                                    Command="{Binding DataFormatCommand}"
                                    CommandParameter="Currency"
                                />
                                <MenuItem
                                    Style="{DynamicResource GhMenuItem}"
                                    Header="Date"
                                    Command="{Binding DataFormatCommand}"
                                    CommandParameter="Date"
                                />
                                <MenuItem
                                    Style="{DynamicResource GhMenuItem}"
                                    Header="Decimal Number"
                                    Command="{Binding DataFormatCommand}"
                                    CommandParameter="Decimal Number"
                                />
                                <MenuItem
                                    Style="{DynamicResource GhMenuItem}"
                                    Header="General"
                                    Command="{Binding DataFormatCommand}"
                                    CommandParameter="General"
                                />
                                <MenuItem
                                    Style="{DynamicResource GhMenuItem}"
                                    Header="Percentage"
                                    Command="{Binding DataFormatCommand}"
                                    CommandParameter="Percentage"
                                />
                                <MenuItem
                                    Style="{DynamicResource GhMenuItem}"
                                    Header="Point"
                                    Command="{Binding DataFormatCommand}"
                                    CommandParameter="Point"
                                />
                                <MenuItem
                                    Style="{DynamicResource GhMenuItem}"
                                    Header="Text"
                                    Command="{Binding DataFormatCommand}"
                                    CommandParameter="Text"
                                />
                                <MenuItem
                                    Style="{DynamicResource GhMenuItem}"
                                    Header="Whole Number"
                                    Command="{Binding DataFormatCommand}"
                                    CommandParameter="Whole Number"
                                />
                                <Separator />
                                <MenuItem
                                    Style="{DynamicResource GhMenuItem}"
                                    Header="Custom Table Cell Format…"
                                    Command="{Binding DataFormatCommand}"
                                />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </WrapPanel>
            </DockPanel>
        </Border>
        <Border Style="{DynamicResource GroupBorder}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Style="{DynamicResource GroupTitle}" Text="Insert" />
                <StackPanel Orientation="Horizontal">
                    <Button
                        Style="{DynamicResource BigButton}"
                        Tag="{DynamicResource IconBlock.Color}"
                        Content="Block"
                        IsEnabled="True"
                        Command="{Binding InsertBlockCommand}"
                        ToolTip="Inserts a block in the cell selected"
                    />
                    <Button
                        Style="{DynamicResource BigButton}"
                        Tag="{DynamicResource IconField.Color}"
                        Content="Field"
                        IsEnabled="True"
                        Command="{Binding InsertFieldCommand}"
                        ToolTip="Inserts a field in the cell selected"
                    />
                    <Button
                        Style="{DynamicResource BigButton}"
                        Tag="{DynamicResource IconFormula.Color}"
                        Content="Formula ▾"
                        IsEnabled="True"
                        Click="OnMenu"
                        ToolTip="Inserts a formula in the cell selected: Sum, Average, Count, Cell or Equation"
                    >
                        <Button.ContextMenu>
                            <ContextMenu
                                Style="{DynamicResource GhContextMenu}"
                                DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                            >
                                <MenuItem
                                    Style="{DynamicResource GhMenuItem}"
                                    Header="Sum"
                                    Command="{Binding InsertFormulaCommand}"
                                    CommandParameter="Sum"
                                />
                                <MenuItem
                                    Style="{DynamicResource GhMenuItem}"
                                    Header="Average"
                                    Command="{Binding InsertFormulaCommand}"
                                    CommandParameter="Average"
                                />
                                <MenuItem
                                    Style="{DynamicResource GhMenuItem}"
                                    Header="Count"
                                    Command="{Binding InsertFormulaCommand}"
                                    CommandParameter="Count"
                                />
                                <MenuItem
                                    Style="{DynamicResource GhMenuItem}"
                                    Header="Cell"
                                    Command="{Binding InsertFormulaCommand}"
                                    CommandParameter="Cell"
                                />
                                <MenuItem
                                    Style="{DynamicResource GhMenuItem}"
                                    Header="Equation"
                                    Command="{Binding InsertFormulaCommand}"
                                    CommandParameter="Equation"
                                />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button
                        Style="{DynamicResource BigButton}"
                        Tag="{DynamicResource IconContents.Color}"
                        Content="Manage Cell Contents"
                        ToolTip="Several contents in a cell: not offered"
                        Margin="0"
                    />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Style="{DynamicResource GroupBorder}" BorderThickness="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Style="{DynamicResource GroupTitle}" Text="Data" />
                <StackPanel Orientation="Horizontal">
                    <Button
                        Style="{DynamicResource BigButton}"
                        Tag="{DynamicResource IconLink.Color}"
                        Content="Link Cell"
                        Command="{Binding LinkCellCommand}"
                        ToolTip="Link the cells to a data link (Excel workbook or CSV file): its data is put in from the cell"
                    />
                    <Button
                        Style="{DynamicResource BigButton}"
                        Tag="{DynamicResource IconDownload.Color}"
                        Content="Download from Source"
                        Command="{Binding DownloadCommand}"
                        ToolTip="Update the table's data links from their sources (DATALINKUPDATE)"
                    />
                    <Button
                        Style="{DynamicResource BigButton}"
                        Tag="{DynamicResource IconUpload.Color}"
                        Content="Upload to Source"
                        Command="{Binding UploadCommand}"
                        ToolTip="Write the table's cells back to the source files of the data links that allow it"
                        Margin="0"
                    />
                </StackPanel>
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>
