<Window
    x:Class="OpenCAD2D.Wpf.TransmittalWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:OpenCAD2D.Wpf"
    Title="Create Transmittal"
    Width="720"
    Height="452"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OpenCAD2D.Wpf;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="/OpenCAD2D.Wpf;component/Themes/StyleDialogs.xaml" />
                <ResourceDictionary Source="/OpenCAD2D.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:BoolToVisibilityConverter x:Key="HiddenWhen" Invert="True" />
            <SolidColorBrush x:Key="TxDisabled" Color="#6B7480" />

            <!-- A tab of the two above the list: its words, a blue line under the one shown. -->
            <Style x:Key="TxTab" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Margin" Value="0,0,14,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border
                                x:Name="Line"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                Padding="8,6"
                            >
                                <ContentPresenter HorizontalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter
                                        TargetName="Line"
                                        Property="BorderBrush"
                                        Value="{StaticResource GhAccent}"
                                    />
                                    <Setter Property="Foreground" Value="{StaticResource GhText}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource GhText}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A box with no words that shows a dash where only some of what it stands for is ticked. -->
            <Style x:Key="TxCheck" TargetType="CheckBox">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border
                                x:Name="Box"
                                Width="13"
                                Height="13"
                                CornerRadius="2"
                                Background="{StaticResource GhInput}"
                                BorderBrush="{StaticResource GhTextMuted}"
                                BorderThickness="1"
                                VerticalAlignment="Center"
                            >
                                <Grid>
                                    <Path
                                        x:Name="Tick"
                                        Data="M2.5 6.5 5 9 10 3.5"
                                        Stroke="White"
                                        StrokeThickness="1.6"
                                        StrokeStartLineCap="Round"
                                        StrokeEndLineCap="Round"
                                        StrokeLineJoin="Round"
                                        Visibility="Collapsed"
                                    />
                                    <Path
                                        x:Name="Dash"
                                        Data="M3 6.5H10"
                                        Stroke="White"
                                        StrokeThickness="1.6"
                                        StrokeStartLineCap="Round"
                                        StrokeEndLineCap="Round"
                                        Visibility="Collapsed"
                                    />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{StaticResource GhAccent}" />
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource GhAccent}" />
                                    <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="{x:Null}">
                                    <Setter TargetName="Box" Property="Background" Value="{StaticResource GhAccent}" />
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource GhAccent}" />
                                    <Setter TargetName="Dash" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Box" Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A row of a list: 22 high, lit under the pointer, never selected. -->
            <Style x:Key="TxRow" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{StaticResource GhText}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Row" Height="22" Background="Transparent" Padding="4,0,6,0">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource GhHover}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A row of the Sheets tab: the space of its depth, an arrow, the box, the picture and the words. -->
            <DataTemplate x:Key="TxSheetRow" DataType="{x:Type local:TransmittalSheetRow}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="{Binding Indent}" />
                    <local:SheetSetIcon
                        x:Name="Chevron"
                        Size="12"
                        Glyph="{Binding Chevron}"
                        VerticalAlignment="Center"
                        Margin="0,0,4,0"
                        MouseLeftButtonDown="OnChevronDown"
                    />
                    <CheckBox
                        Style="{StaticResource TxCheck}"
                        IsChecked="{Binding IsChecked, Mode=TwoWay}"
                        IsEnabled="{Binding IsEnabled}"
                        Margin="0,0,6,0"
                        AutomationProperties.Name="{Binding Text}"
                    />
                    <local:SheetSetIcon Glyph="{Binding Icon}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBlock
                        x:Name="Words"
                        Text="{Binding Text}"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                    />
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsExpandable}" Value="False">
                        <Setter TargetName="Chevron" Property="Visibility" Value="Hidden" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="SheetSet">
                        <Setter TargetName="Words" Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="Error">
                        <Setter TargetName="Words" Property="Foreground" Value="{StaticResource GhProblem}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- A row of the Files Table: the box, the picture and name, where it goes in the zip, its size. -->
            <DataTemplate x:Key="TxFileRow" DataType="{x:Type local:TransmittalFileRow}">
                <Grid ToolTip="{Binding ToolTip}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="128" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <CheckBox
                        Style="{StaticResource TxCheck}"
                        IsChecked="{Binding IsIncluded, Mode=TwoWay}"
                        IsEnabled="{Binding IsEnabled}"
                        AutomationProperties.Name="{Binding Name}"
                    />
                    <DockPanel Grid.Column="1" LastChildFill="True">
                        <local:SheetSetIcon
                            DockPanel.Dock="Left"
                            Glyph="{Binding Icon}"
                            VerticalAlignment="Center"
                            Margin="0,0,5,0"
                        />
                        <TextBlock
                            x:Name="Words"
                            Text="{Binding Name}"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                        />
                    </DockPanel>
                    <TextBlock
                        x:Name="Where"
                        Grid.Column="2"
                        Text="{Binding Where}"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{StaticResource GhTextMuted}"
                    />
                    <TextBlock
                        Grid.Column="3"
                        Text="{Binding SizeText}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Foreground="{StaticResource GhTextMuted}"
                    />
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Tone}" Value="Error">
                        <Setter TargetName="Words" Property="Foreground" Value="{StaticResource GhProblem}" />
                        <Setter TargetName="Where" Property="Foreground" Value="{StaticResource GhProblem}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Design A12Etransmit: Create Transmittal, reduced: the Sheets and Files Table tabs, the notes, the zip file, the fields box. -->
    <Border
        x:Name="Root"
        Background="{StaticResource GhPanel}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhHeader}"
                Padding="16,12"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnCancel"
                        ToolTip="Close"
                    />
                    <TextBlock
                        Text="Create Transmittal"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                    />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource GhHeader}" Padding="16,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="View Report…"
                            Padding="14,5"
                            MinWidth="75"
                            Margin="0,0,8,0"
                            Click="OnViewReport"
                        />
                        <Button
                            Style="{StaticResource StylePrimaryButton}"
                            Content="OK"
                            Padding="14,5"
                            MinWidth="75"
                            Margin="0,0,8,0"
                            IsDefault="True"
                            Click="OnOk"
                        />
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="Cancel"
                            Padding="14,5"
                            MinWidth="75"
                            Margin="0,0,8,0"
                            IsCancel="True"
                            Click="OnCancel"
                        />
                        <Button
                            Style="{StaticResource GhDialogButton}"
                            Content="Help"
                            Padding="14,5"
                            MinWidth="75"
                            Click="OnHelp"
                        />
                    </StackPanel>
                    <TextBlock
                        x:Name="Footer"
                        Text="{Binding FooterText}"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap"
                        Margin="0,0,12,0"
                        AutomationProperties.Name="Message"
                    >
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FooterIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource GhProblem}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
            </Border>

            <Grid Margin="16,12,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="256" />
                </Grid.ColumnDefinitions>

                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <RadioButton
                            x:Name="SheetsTab"
                            Style="{StaticResource TxTab}"
                            GroupName="TxTabs"
                            Content="Sheets"
                            Checked="OnTab"
                        />
                        <RadioButton
                            x:Name="FilesTab"
                            Style="{StaticResource TxTab}"
                            GroupName="TxTabs"
                            Content="Files Table"
                            Checked="OnTab"
                        />
                    </StackPanel>
                    <Border
                        Background="{StaticResource GhInput}"
                        BorderBrush="{StaticResource GhBorder}"
                        BorderThickness="1"
                        CornerRadius="4"
                    >
                        <Grid>
                            <ListBox
                                x:Name="SheetList"
                                Style="{StaticResource GhListBox}"
                                Background="Transparent"
                                BorderThickness="0"
                                ItemsSource="{Binding Rows}"
                                ItemContainerStyle="{StaticResource TxRow}"
                                ItemTemplate="{StaticResource TxSheetRow}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                Visibility="{Binding IsSheetsTab, Converter={StaticResource Shown}}"
                                AutomationProperties.Name="Sheets"
                            />
                            <DockPanel Visibility="{Binding IsFilesTab, Converter={StaticResource Shown}}">
                                <Grid DockPanel.Dock="Top" Margin="4,4,6,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="128" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="File name"
                                        FontSize="11"
                                        Foreground="{StaticResource GhTextMuted}"
                                    />
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="Path in zip"
                                        FontSize="11"
                                        Foreground="{StaticResource GhTextMuted}"
                                    />
                                    <TextBlock
                                        Grid.Column="3"
                                        Text="Size"
                                        FontSize="11"
                                        HorizontalAlignment="Right"
                                        Foreground="{StaticResource GhTextMuted}"
                                    />
                                </Grid>
                                <ListBox
                                    x:Name="FileList"
                                    Style="{StaticResource GhListBox}"
                                    Background="Transparent"
                                    BorderThickness="0,1,0,0"
                                    BorderBrush="{StaticResource GhBorder}"
                                    ItemsSource="{Binding FileRows}"
                                    ItemContainerStyle="{StaticResource TxRow}"
                                    ItemTemplate="{StaticResource TxFileRow}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    AutomationProperties.Name="Files"
                                />
                            </DockPanel>
                        </Grid>
                    </Border>
                </DockPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock
                        Text="Enter notes to be included with this transmittal package:"
                        TextWrapping="Wrap"
                        Margin="0,6,0,6"
                    />
                    <TextBox
                        Style="{StaticResource BlockBox}"
                        Height="120"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto"
                        VerticalContentAlignment="Top"
                        Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="Notes"
                    />
                    <TextBlock Text="Zip file:" Margin="0,14,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Style="{StaticResource BlockBox}"
                            Text="{Binding ZipPath, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="{Binding ZipPath}"
                            AutomationProperties.Name="Zip file"
                        />
                        <Button
                            Grid.Column="1"
                            Style="{StaticResource GhDialogButton}"
                            Content="…"
                            Padding="12,4"
                            Margin="8,0,0,0"
                            ToolTip="Browse for the zip file"
                            AutomationProperties.Name="Browse"
                            Click="OnBrowse"
                        />
                    </Grid>
                    <CheckBox
                        Style="{StaticResource StyleCheck}"
                        Content="Update fields in the copies first"
                        IsChecked="{Binding UpdateFields, Mode=TwoWay}"
                        Margin="0,14,0,0"
                    />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
