<Window
    x:Class="OpenCAD2D.Wpf.UcsDepthWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Orthographic UCS depth"
    Width="436"
    SizeToContent="Height"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OpenCAD2D.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhBg}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhPanel}"
                BorderBrush="{StaticResource GhBorder}"
                BorderThickness="0,0,0,1"
                Padding="12,8"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <TextBlock Text="Orthographic UCS depth" FontWeight="SemiBold" />
            </Border>

            <TextBlock
                DockPanel.Dock="Bottom"
                Text="{Binding Notice}"
                Foreground="{StaticResource GhWarn}"
                FontSize="11"
                Margin="12,0,12,8"
            >
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Text="{Binding Label}"
                    Foreground="{StaticResource GhIcon}"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"
                />
                <TextBox
                    x:Name="DepthBox"
                    Grid.Column="1"
                    Style="{StaticResource BlockNumber}"
                    Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                    AutomationProperties.Name="Depth"
                />
                <Button
                    Grid.Column="2"
                    Style="{StaticResource GhDialogButton}"
                    Padding="5"
                    Margin="8,0,0,0"
                    Click="OnPick"
                    ToolTip="Select new origin"
                    AutomationProperties.Name="Select new origin"
                >
                    <Path
                        Data="M4 4l7 17 2-7 7-2z"
                        Stroke="{StaticResource GhIcon}"
                        StrokeThickness="1.8"
                        StrokeLineJoin="Round"
                        Stretch="Uniform"
                        Width="16"
                        Height="16"
                    />
                </Button>
                <Button
                    Grid.Column="3"
                    Style="{StaticResource StylePrimaryButton}"
                    Content="OK"
                    Padding="14,5"
                    MinWidth="75"
                    Margin="8,0,0,0"
                    Click="OnOk"
                    IsDefault="True"
                />
                <Button
                    Grid.Column="4"
                    Style="{StaticResource GhDialogButton}"
                    Content="Cancel"
                    Padding="14,5"
                    MinWidth="75"
                    Margin="8,0,0,0"
                    Click="OnCancel"
                    IsCancel="True"
                />
            </Grid>
        </DockPanel>
    </Border>
</Window>
