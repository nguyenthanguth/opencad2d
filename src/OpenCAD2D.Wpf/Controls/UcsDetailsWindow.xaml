<Window
    x:Class="OpenCAD2D.Wpf.UcsDetailsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:OpenCAD2D.Wpf"
    Title="UCS Details"
    Width="483"
    SizeToContent="Height"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#262B33"
>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OpenCAD2D.Wpf;component/Themes/BlockDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- One group of the dialog: its title set in its top edge, the three numbers under it in mono type. -->
            <DataTemplate x:Key="Group" DataType="{x:Type local:UcsVectorText}">
                <HeaderedContentControl Style="{StaticResource UcsGroup}" Header="{Binding Title}" Margin="0,0,8,0">
                    <StackPanel TextElement.FontFamily="{StaticResource GhMonoFont}" TextElement.FontSize="11">
                        <TextBlock Text="{Binding X, StringFormat=X:  {0}}" />
                        <TextBlock Text="{Binding Y, StringFormat=Y:  {0}}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Z, StringFormat=Z:  {0}}" Margin="0,4,0,0" />
                    </StackPanel>
                </HeaderedContentControl>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        x:Name="Root"
        Background="{StaticResource GhBg}"
        BorderBrush="{StaticResource GhBorder}"
        BorderThickness="1"
        TextElement.FontFamily="{StaticResource GhFont}"
        TextElement.FontSize="12"
        TextElement.Foreground="{StaticResource GhText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
    >
        <DockPanel>
            <!-- Header: the title, dragged to move the dialog, and the close cross. -->
            <Border
                DockPanel.Dock="Top"
                Background="{StaticResource GhPanel}"
                BorderBrush="{StaticResource GhBorder}"
                BorderThickness="0,0,0,1"
                Padding="12,6"
                MouseLeftButtonDown="OnHeaderDown"
            >
                <DockPanel>
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhTitleCloseButton}"
                        Click="OnClose"
                        ToolTip="Close"
                    />
                    <TextBlock Text="UCS Details" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <StackPanel Margin="12,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Name:  " Foreground="{StaticResource GhIcon}" />
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource Group}" Margin="0,8,-8,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <DockPanel Margin="0,8,0,0">
                    <Button
                        DockPanel.Dock="Right"
                        Style="{StaticResource StylePrimaryButton}"
                        Content="OK"
                        Width="75"
                        Padding="0,4"
                        Click="OnClose"
                        IsDefault="True"
                        IsCancel="True"
                    />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Text="Relative to:"
                            Foreground="{StaticResource GhIcon}"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                        />
                        <ComboBox
                            Style="{StaticResource GhComboBox}"
                            Width="153"
                            ItemsSource="{Binding RelativeToChoices}"
                            SelectedItem="{Binding RelativeTo, Mode=TwoWay}"
                            DisplayMemberPath="Name"
                            AutomationProperties.Name="Relative to"
                        />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
