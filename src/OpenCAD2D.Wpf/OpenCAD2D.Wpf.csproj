<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
        <UseWPF>true</UseWPF>
        <PlatformTarget>x64</PlatformTarget>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RootNamespace>OpenCAD2D.Wpf</RootNamespace>
        <AssemblyName>OpenCAD2D.Wpf</AssemblyName>
        <Description>The controls of the OpenCAD2D presenter: the canvas drawn with SkiaSharp, the file list, Properties, the layer box, the command line and the status bar.</Description>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);MSB3277</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\OpenCAD2D.Core\OpenCAD2D.Core.csproj" />
        <Reference Include="GeometryHelper" HintPath="$(GeometryHelperLib)GeometryHelper.dll" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="OpenCAD2D.UnitTest" />
        <InternalsVisibleTo Include="OpenCAD2D.Wpf.UnitTest" />
        <InternalsVisibleTo Include="OpenCAD2D.Plugins.UnitTest" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="SkiaSharp" Version="4.155.0" />
    </ItemGroup>

    <!-- The compiler of plugins given as C# source, on .NET 8 only: hosted in Tekla on .NET Framework a .cs plugin is refused. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    </ItemGroup>

    <!--
    The NuGet client (Apache-2.0) that restores the packages a C# plugin's .csproj names, with no .NET SDK, on .NET 8 only.
    7.9.0 is the last version with a net8.0 target: 8.0.0 targets net10.0 and net472 only.
  -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
        <PackageReference Include="NuGet.Protocol" Version="7.9.0" />
    </ItemGroup>

    <!-- The printers of Windows the Plot dialog lists and prints to; .NET 8's WPF brings System.Printing and ReachFramework itself. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
        <Reference Include="System.Printing" />
        <Reference Include="ReachFramework" />
    </ItemGroup>
</Project>
