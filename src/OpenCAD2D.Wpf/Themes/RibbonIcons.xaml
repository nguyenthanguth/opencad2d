    <!-- The frame every drawing is clipped to, as the SVG files are by their viewBox. -->
    <RectangleGeometry x:Key="RibbonIconGrid" Rect="0,0,32,32" po:Freeze="True" />

    <!-- The tints: a colour at 30 or 60 %, the inside of a closed part. -->
    <SolidColorBrush x:Key="RibbonTintBlue30" Color="{StaticResource GhIconBlueColor}" Opacity="0.3" po:Freeze="True" />
    <SolidColorBrush x:Key="RibbonTintBlue60" Color="{StaticResource GhIconBlueColor}" Opacity="0.6" po:Freeze="True" />
    <SolidColorBrush
        x:Key="RibbonTintGreen30"
        Color="{StaticResource GhIconGreenColor}"
        Opacity="0.3"
        po:Freeze="True"
    />
    <SolidColorBrush x:Key="RibbonTintGrey30" Color="{StaticResource GhIconGreyColor}" Opacity="0.3" po:Freeze="True" />
    <SolidColorBrush x:Key="RibbonTintRed30" Color="{StaticResource GhIconRedColor}" Opacity="0.3" po:Freeze="True" />
    <SolidColorBrush x:Key="RibbonTintTeal30" Color="{StaticResource GhIconTealColor}" Opacity="0.3" po:Freeze="True" />
    <SolidColorBrush
        x:Key="RibbonTintYellow30"
        Color="{StaticResource GhIconYellowColor}"
        Opacity="0.3"
        po:Freeze="True"
    />

