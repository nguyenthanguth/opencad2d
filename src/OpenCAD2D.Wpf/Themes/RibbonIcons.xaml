<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    xmlns:local="clr-namespace:OpenCAD2D.Wpf"
    mc:Ignorable="po"
>
    <!--
    The colour icons of the ribbon, one RibbonIcon per command, keyed <old icon key>.Color. Written by
    tools/ribbon-icons/build.py from the drawings in tools/ribbon-icons/svg: change an icon there, never here.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/OpenCAD2D.Wpf;component/Themes/Dark.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- The pens: 2 units square for the lines, 4 butt for the badges and text bars, 1 square for the detail. -->
    <Pen
        x:Key="RibbonPenBlue2"
        Brush="{StaticResource GhIconBlue}"
        Thickness="2"
        StartLineCap="Square"
        EndLineCap="Square"
        LineJoin="Miter"
        MiterLimit="4"
        po:Freeze="True"
    />
    <Pen
        x:Key="RibbonPenBlue4Butt"
        Brush="{StaticResource GhIconBlue}"
        Thickness="4"
        StartLineCap="Flat"
        EndLineCap="Flat"
        LineJoin="Miter"
        MiterLimit="4"
        po:Freeze="True"
    />
    <Pen
        x:Key="RibbonPenGreen2"
        Brush="{StaticResource GhIconGreen}"
        Thickness="2"
        StartLineCap="Square"
        EndLineCap="Square"
        LineJoin="Miter"
        MiterLimit="4"
        po:Freeze="True"
    />
    <Pen
        x:Key="RibbonPenGreen4Butt"
        Brush="{StaticResource GhIconGreen}"
        Thickness="4"
        StartLineCap="Flat"
        EndLineCap="Flat"
        LineJoin="Miter"
        MiterLimit="4"
        po:Freeze="True"
    />
    <Pen
        x:Key="RibbonPenGrey1"
        Brush="{StaticResource GhIconGrey}"
        Thickness="1"
        StartLineCap="Square"
        EndLineCap="Square"
        LineJoin="Miter"
        MiterLimit="4"
        po:Freeze="True"
    />
    <Pen
