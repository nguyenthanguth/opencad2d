<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:OpenCAD2D.Wpf"
>
    <!-- What the sheet set dialogs (A12 4b: Sheet Set, Subset and Sheet Properties, Custom Properties, New Sheet, Rename and
         Renumber, Import Layouts) share, on top of Dark.xaml and StyleDialogs.xaml: the window, the frame with its header and
         footer, a box, the red and yellow lines. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/OpenCAD2D.Wpf;component/Themes/Dark.xaml" />
        <ResourceDictionary Source="/OpenCAD2D.Wpf;component/Themes/StyleDialogs.xaml" />
        <ResourceDictionary Source="/OpenCAD2D.Wpf;component/Themes/BlockDialogs.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="SheetSetRed" Color="#FF8A7A" />
    <SolidColorBrush x:Key="SheetSetRedGround" Color="#3A2626" />
    <SolidColorBrush x:Key="SheetSetRedLine" Color="#7A3A33" />
    <SolidColorBrush x:Key="SheetSetYellow" Color="#E8B94A" />
    <SolidColorBrush x:Key="SheetSetYellowGround" Color="#3A3322" />
    <SolidColorBrush x:Key="SheetSetYellowLine" Color="#6E5A2A" />
    <local:BoolToVisibilityConverter x:Key="SheetSetShown" />
    <local:BoolToVisibilityConverter x:Key="SheetSetHidden" Invert="True" />

    <Style x:Key="SheetSetWindow" TargetType="Window">
        <Setter Property="SizeToContent" Value="Height" />
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="ShowInTaskbar" Value="False" />
        <Setter Property="Background" Value="#262B33" />
    </Style>

    <!-- The frame of a dialog: the header with the title and the close cross, the footer with OK, Cancel and Help (a locked
         set has one Close and Help), what the dialog puts at the left of the footer, and its content between. -->
    <Style x:Key="SheetSetFrame" TargetType="local:SheetSetDialogFrame">
        <Setter Property="Background" Value="{StaticResource GhPanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource GhBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource GhText}" />
        <Setter Property="FontFamily" Value="{StaticResource GhFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SheetSetDialogFrame">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6"
                        TextOptions.TextFormattingMode="Display"
                    >
                        <DockPanel>
                            <Border
                                x:Name="PART_Header"
                                DockPanel.Dock="Top"
                                Background="{StaticResource GhHeader}"
                                Padding="16,10"
                                CornerRadius="6,6,0,0"
                            >
                                <DockPanel>
                                    <Button
                                        x:Name="PART_Cross"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource GhTitleCloseButton}"
                                        ToolTip="Close"
                                    />
                                    <TextBlock
                                        Text="{TemplateBinding Title}"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                    />
                                </DockPanel>
                            </Border>
                            <Border
                                DockPanel.Dock="Bottom"
                                Background="{StaticResource GhHeader}"
                                Padding="16,10"
                                CornerRadius="0,0,6,6"
                            >
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button
                                            x:Name="PART_Ok"
                                            Style="{StaticResource GhAccentButton}"
                                            MinWidth="75"
                                            Margin="0,0,8,0"
                                            Content="{TemplateBinding OkText}"
                                            IsDefault="True"
                                            IsEnabled="{TemplateBinding OkEnabled}"
                                        />
                                        <Button
                                            x:Name="PART_Cancel"
                                            Style="{StaticResource GhDialogButton}"
                                            MinWidth="75"
                                            Margin="0,0,8,0"
                                            Content="Cancel"
                                            IsCancel="True"
                                        />
                                        <Button
                                            x:Name="PART_Close"
                                            Style="{StaticResource GhAccentButton}"
                                            MinWidth="75"
                                            Margin="0,0,8,0"
                                            Content="Close"
                                            IsCancel="True"
                                            Visibility="Collapsed"
                                        />
                                        <Button
                                            x:Name="PART_Help"
                                            Style="{StaticResource GhDialogButton}"
                                            MinWidth="75"
                                            Content="Help"
                                        />
                                    </StackPanel>
                                    <ContentPresenter
                                        Content="{TemplateBinding FooterContent}"
                                        VerticalAlignment="Center"
                                    />
                                </DockPanel>
                            </Border>
                            <ContentPresenter />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsReadOnlyMode" Value="True">
                            <Setter TargetName="PART_Ok" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Cancel" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Close" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A box of a dialog: the input colour, a hairline, the accent when it holds the keyboard, red when its Tag is True,
         grey when it cannot be typed in. -->
    <Style x:Key="SheetSetBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource GhText}" />
        <Setter Property="CaretBrush" Value="{StaticResource GhText}" />
        <Setter Property="SelectionBrush" Value="{StaticResource GhAccent}" />
        <Setter Property="FontFamily" Value="{StaticResource GhFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border
                        x:Name="Box"
                        Background="{StaticResource GhInput}"
                        BorderBrush="{StaticResource GhBorder}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="{TemplateBinding Padding}"
                    >
                        <ScrollViewer
                            x:Name="PART_ContentHost"
                            Focusable="False"
                            VerticalAlignment="Center"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden"
                        />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource GhAccent}" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource GhPanel}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource SheetSetRed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The red line under a grid or a form: why a value is refused. -->
    <Style x:Key="SheetSetErrorBox" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SheetSetRedGround}" />
        <Setter Property="BorderBrush" Value="{StaticResource SheetSetRedLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Margin" Value="0,8,0,0" />
        <Style.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource SheetSetRed}" />
            </Style>
        </Style.Resources>
    </Style>

    <!-- The yellow line: a notice that does not stop OK, and the lock of a set. -->
    <Style x:Key="SheetSetNoticeBox" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SheetSetYellowGround}" />
        <Setter Property="BorderBrush" Value="{StaticResource SheetSetYellowLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Margin" Value="0,8,0,0" />
        <Style.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource SheetSetYellow}" />
            </Style>
        </Style.Resources>
    </Style>

    <Style x:Key="SheetSetLabel" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource GhText}" />
        <Setter Property="Margin" Value="0,0,10,0" />
    </Style>

    <!-- A check box whose box is grey when it is off the table, as the Rename Options' second Prefix box is. -->
    <Style x:Key="SheetSetCheck" TargetType="CheckBox" BasedOn="{StaticResource BlockCheck}" />

    <!-- A row of a list of these dialogs: the hairline and accent selection of the page setup lists, in the theme's text colour. -->
    <Style x:Key="SheetSetListRow" TargetType="ListBoxItem" BasedOn="{StaticResource SetupRow}">
        <Setter Property="Foreground" Value="{StaticResource GhText}" />
    </Style>

    <!-- The "..." button at the end of a value. -->
    <Style x:Key="SheetSetDots" TargetType="Button" BasedOn="{StaticResource GhDialogButton}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="26" />
        <Setter Property="Content" Value="..." />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="4,0,0,0" />
    </Style>
</ResourceDictionary>
