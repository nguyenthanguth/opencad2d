<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:OpenCAD2D.Wpf"
>
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/OpenCAD2D.Wpf;component/Themes/BlockDialogs.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- What the Sheet Views and Model Views tabs of the Sheet Set Manager share: the rows of their trees and the buttons of
         their toolbars (design A12SsmSheetViews and A12SsmModelViews). The Sheet List tab keeps its own, in the window. -->
    <SolidColorBrush x:Key="SsmTabMuted" Color="#6B7480" />
    <SolidColorBrush x:Key="SsmTabError" Color="#FF8A7A" />

    <!-- A row of a tree: 22 high, selected in the blue of the window's selections, bold for the set and a location, grey words
         at the right (the sheet a view is on, or the scale it is placed at). -->
    <Style x:Key="SsmTabRow" TargetType="ListBoxItem">
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        <Setter Property="Foreground" Value="{StaticResource GhText}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" Height="22" Background="Transparent" Padding="4,0,6,0">
                        <DockPanel>
                            <TextBlock
                                DockPanel.Dock="Right"
                                Text="{Binding Detail}"
                                Foreground="{StaticResource GhTextMuted}"
                                VerticalAlignment="Center"
                                Margin="8,0,0,0"
                            />
                            <Border DockPanel.Dock="Left" Width="{Binding Indent}" />
                            <local:SheetSetIcon
                                x:Name="Chevron"
                                DockPanel.Dock="Left"
                                Size="12"
                                Glyph="{Binding Chevron}"
                                VerticalAlignment="Center"
                                Margin="0,0,4,0"
                            />
                            <local:SheetSetIcon
                                DockPanel.Dock="Left"
                                Glyph="{Binding Icon}"
                                VerticalAlignment="Center"
                                Margin="0,0,4,0"
                            />
                            <TextBlock
                                x:Name="Words"
                                Text="{Binding Text}"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding Text}"
                            />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsExpandable}" Value="False">
                            <Setter TargetName="Chevron" Property="Visibility" Value="Hidden" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsBold}" Value="True">
                            <Setter TargetName="Words" Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tone}" Value="Muted">
                            <Setter TargetName="Words" Property="Foreground" Value="{StaticResource SsmTabMuted}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tone}" Value="Error">
                            <Setter TargetName="Words" Property="Foreground" Value="{StaticResource SsmTabError}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource GhHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource GhSelected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A button of a tab's toolbar: a picture, faded where it is off. -->
    <Style x:Key="SsmTabTool" TargetType="Button">
        <Setter Property="Height" Value="26" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Chrome"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        CornerRadius="4"
                    >
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource GhHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A button of the toolbar that is one of two (View by Category, View by Sheet): the one on has a blue border and ground. -->
    <Style x:Key="SsmTabToggle" TargetType="RadioButton">
        <Setter Property="Height" Value="26" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border
                        x:Name="Chrome"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        CornerRadius="4"
                    >
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource GhHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource GhSelected}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource GhAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
