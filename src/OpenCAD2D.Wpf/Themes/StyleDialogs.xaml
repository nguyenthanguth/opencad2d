<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:OpenCAD2D.Wpf"
>
    <!-- The look the style dialogs (Text Style, Dimension Style Manager and its dialogs) share, dark as the window's others. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/OpenCAD2D.Wpf;component/Themes/Dark.xaml" />
        <ResourceDictionary Source="/OpenCAD2D.Wpf;component/Themes/Icons.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <local:BoolToVisibilityConverter x:Key="Shown" />
    <local:RgbBrushConverter x:Key="RgbBrush" />

    <Style x:Key="StyleLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <!-- The title of a group of fields: 13 high, semibold. -->
    <Style x:Key="StyleGroup" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- A box typed in: framed by the border's colour on the input's, its words in mono type, greyed when off. -->
    <Style x:Key="StyleBox" TargetType="TextBox" BasedOn="{StaticResource GhTextBox}">
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Background" Value="{StaticResource GhInput}" />
        <Setter Property="BorderBrush" Value="{StaticResource GhBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource GhMonoFont}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="2"
                        Padding="{TemplateBinding Padding}"
                    >
                        <ScrollViewer
                            x:Name="PART_ContentHost"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden"
                        />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A box to tick with its words after it, the words greyed when off. -->
    <Style x:Key="StyleCheck" TargetType="CheckBox" BasedOn="{StaticResource GhCheckBox}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource GhText}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border
                            x:Name="Box"
                            Width="13"
                            Height="13"
                            CornerRadius="2"
                            Background="{StaticResource GhInput}"
                            BorderBrush="{StaticResource GhTextMuted}"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                        >
                            <Path
                                x:Name="Tick"
                                Data="M2.5 6.5 5 9 10 3.5"
                                Stroke="White"
                                StrokeThickness="1.6"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                Visibility="Collapsed"
                            />
                        </Border>
                        <ContentPresenter x:Name="Words" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource GhAccent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource GhAccent}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Words" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
                            <Setter TargetName="Box" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StyleSideButton" TargetType="Button" BasedOn="{StaticResource GhDialogButton}">
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- The button of a dialog that does its work (OK, Apply, Modify…): the accent, its words dark. -->
    <Style x:Key="StylePrimaryButton" TargetType="Button" BasedOn="{StaticResource GhAccentButton}" />

    <!-- A tab of the dimension style's dialog: the selection's colour when shown, rounded at the top only. -->
    <Style x:Key="StyleTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource GhTextMuted}" />
        <Setter Property="FontFamily" Value="{StaticResource GhFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="4,4,0,0" Padding="11,6">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource GhSelected}" />
                            <Setter Property="Foreground" Value="{StaticResource GhText}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource GhText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A box of words under a preview: framed, rounded. -->
    <Style x:Key="StyleFrame" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource GhBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <!--
    A group box of a style dialog's tab: a 1 px border in the border's colour, rounded by 4, its title a legend in the top line
    (12 high, semibold) on the panel's ground.
    -->
    <Style x:Key="StyleGroupBox" TargetType="GroupBox">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Border
                            BorderBrush="{StaticResource GhBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Margin="0,8,0,0"
                            Padding="10,14,10,8"
                        >
                            <ContentPresenter />
                        </Border>
                        <Border
                            Background="{StaticResource GhPanel}"
                            Padding="4,0"
                            Margin="10,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                        >
                            <ContentPresenter
                                ContentSource="Header"
                                TextElement.FontSize="12"
                                TextElement.FontWeight="SemiBold"
                                TextElement.Foreground="{StaticResource GhText}"
                            />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The dot of a notice: the accent's, the warning's where the notice says why something was refused (IsNoticeWarning). -->
    <Style x:Key="NoticeDot" TargetType="Ellipse">
        <Setter Property="Fill" Value="{StaticResource GhAccent}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsNoticeWarning}" Value="True">
                <Setter Property="Fill" Value="{StaticResource GhWarn}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The black ground of a preview, as the canvas's. -->
    <Style x:Key="StylePreview" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource GhBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{StaticResource GhCanvas}" />
    </Style>

    <!-- A list of styles: the current one marked, the selected one on the selection's colour. -->
    <Style x:Key="StyleListItem" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" Background="Transparent" Padding="10,5">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource GhSelected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A style of a list: the current mark, the name in semibold, then its font (text styles). -->
    <DataTemplate x:Key="StyleRowTemplate" DataType="{x:Type local:StyleRowViewModel}">
        <DockPanel>
            <TextBlock
                x:Name="Mark"
                DockPanel.Dock="Left"
                Text="✓"
                Width="14"
                Margin="0,0,6,0"
                Foreground="{StaticResource GhOk}"
                Visibility="Hidden"
            />
            <Grid DockPanel.Dock="Right" MaxWidth="112" Margin="6,0,0,0" ToolTip="{Binding DetailAll}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Text="{Binding Detail}"
                    Foreground="{StaticResource GhTextMuted}"
                    FontFamily="{StaticResource GhMonoFont}"
                    TextTrimming="CharacterEllipsis"
                />
                <TextBlock
                    Grid.Column="1"
                    Text="{Binding DetailLocal}"
                    Margin="6,0,0,0"
                    MaxWidth="52"
                    Foreground="{StaticResource GhTextMuted}"
                    FontSize="11"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                />
            </Grid>
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--
    A font of the Font name list with its kind: SHX or TT, the English name, the family's other names after it in muted words
    (trimmed with an ellipsis where the box is too narrow, all of them in the tooltip), and "(not installed)" or "(not found)"
    where this machine lacks it.
    -->
    <DataTemplate x:Key="FontItemTemplate" DataType="{x:Type local:FontItemViewModel}">
        <Grid ToolTip="{Binding AllNames}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border
                CornerRadius="3"
                Margin="0,0,6,0"
                Padding="4,0"
                Background="{StaticResource GhSelected}"
                VerticalAlignment="Center"
            >
                <TextBlock x:Name="Mark" Text="SHX" FontSize="9" FontWeight="SemiBold" />
            </Border>
            <TextBlock
                Grid.Column="1"
                Text="{Binding Name}"
                VerticalAlignment="Center"
                FontFamily="{StaticResource GhMonoFont}"
            />
            <TextBlock
                Grid.Column="2"
                Text="{Binding LocalText}"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Foreground="{StaticResource GhTextMuted}"
                FontSize="11"
                TextTrimming="CharacterEllipsis"
            />
            <TextBlock
                Grid.Column="3"
                Text="{Binding Hint}"
                Margin="6,0,0,0"
                VerticalAlignment="Center"
                Foreground="{StaticResource GhTextMuted}"
                FontSize="11"
            />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsTrueType}" Value="True">
                <Setter TargetName="Mark" Property="Text" Value="TT" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A big font of the Big font list: its name, and "(not found)" where no font folder has it. -->
    <DataTemplate x:Key="BigFontItemTemplate" DataType="{x:Type local:FontItemViewModel}">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            <TextBlock
                Text="{Binding Hint}"
                Margin="6,0,0,0"
                VerticalAlignment="Center"
                Foreground="{StaticResource GhTextMuted}"
                FontSize="11"
            />
        </StackPanel>
    </DataTemplate>

    <!--
    An item of a list of the style dialogs: its words, after the picture of an arrowhead in the lists of arrowheads, as
    AutoCAD's lists show them; the words alone in any other list.
    -->
    <DataTemplate x:Key="ArrowChoiceTemplate">
        <StackPanel Orientation="Horizontal">
            <Image x:Name="Picture" Source="{Binding Picture}" Width="22" Height="12" Margin="0,0,6,0" Stretch="None" />
            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Picture}" Value="{x:Null}">
                <Setter TargetName="Picture" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- The cell of a box to tick of a pair row: the ground of a field the preview shows or lights, as a row has it. -->
    <Style x:Key="DimPairCell" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="4,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Background" Value="#731F4E79" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsLit}" Value="True">
                <Setter Property="Background" Value="#731F4E79" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
    A field of a dimension style's dialog, as the design lays it: the label with the variable beside it in small mono type,
    then a box (190 wide, 150 in the right column) holding a box to tick, a number (90 wide), a text, or a list with the
    colour's swatch before it and the "…" of the Text Style dialog after it; a list of the right column sits under its label,
    the width of its group box, where 150 would cut its words. Greyed where the field means nothing.
    -->
    <DataTemplate x:Key="DimFieldTemplate" DataType="{x:Type local:DimFieldViewModel}">
        <Grid x:Name="Row" Margin="0,2" MinHeight="24" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- The mark of the row the preview shows (the field active) or the row of a field that sets the part under the pointer: an accent bar and a ground. -->
            <Rectangle
                x:Name="Bar"
                Grid.ColumnSpan="2"
                Grid.RowSpan="2"
                Width="3"
                HorizontalAlignment="Left"
                Margin="-6,0,0,0"
                Fill="{StaticResource GhAccent}"
                Visibility="Collapsed"
            />
            <StackPanel x:Name="Caption" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                <TextBlock x:Name="CaptionText" Text="{Binding Label}" VerticalAlignment="Center" />
                <TextBlock
                    Text="{Binding VariableText}"
                    Margin="6,0,0,0"
                    FontSize="10"
                    FontFamily="{StaticResource GhMonoFont}"
                    Foreground="{StaticResource GhTextMuted}"
                    VerticalAlignment="Center"
                />
            </StackPanel>
            <DockPanel x:Name="Control" Grid.Column="1" Width="{Binding FieldWidth}" IsEnabled="{Binding IsEnabled}">
                <Border
                    x:Name="Swatch"
                    DockPanel.Dock="Left"
                    Width="12"
                    Height="12"
                    Margin="0,0,4,0"
                    BorderBrush="#5B6573"
                    BorderThickness="1"
                    Background="{Binding SwatchRgb, Converter={StaticResource RgbBrush}}"
                    Visibility="Collapsed"
                />
                <Button
                    x:Name="More"
                    DockPanel.Dock="Right"
                    Style="{StaticResource GhDialogButton}"
                    Content="…"
                    Width="26"
                    Padding="0,3"
                    Margin="4,0,0,0"
                    Visibility="Collapsed"
                    Command="{Binding DataContext.TextStylesCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    ToolTip="Open the Text style dialog"
                />
                <Grid>
                    <TextBox
                        x:Name="Number"
                        Style="{StaticResource StyleBox}"
                        Width="90"
                        HorizontalAlignment="Left"
                        Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="Collapsed"
                    />
                    <TextBox
                        x:Name="Typed"
                        Style="{StaticResource StyleBox}"
                        Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="Collapsed"
                    />
                    <ComboBox
                        x:Name="Pick"
                        Style="{StaticResource GhComboBox}"
                        ItemsSource="{Binding Choices}"
                        SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                        ItemTemplate="{StaticResource ArrowChoiceTemplate}"
                        Visibility="Collapsed"
                    />
                    <CheckBox
                        x:Name="Tick"
                        Style="{StaticResource StyleCheck}"
                        IsChecked="{Binding IsChecked, Mode=TwoWay}"
                        HorizontalAlignment="Left"
                        Visibility="Collapsed"
                    />
                </Grid>
            </DockPanel>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                <Setter TargetName="Row" Property="Background" Value="#731F4E79" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsLit}" Value="True">
                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                <Setter TargetName="Row" Property="Background" Value="#731F4E79" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HasTextStyleButton}" Value="True">
                <Setter TargetName="More" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Number">
                <Setter TargetName="Number" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Angle">
                <Setter TargetName="Number" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Text">
                <Setter TargetName="Typed" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Choice">
                <Setter TargetName="Pick" Property="Visibility" Value="Visible" />
                <Setter TargetName="Swatch" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding SwatchRgb}" Value="{x:Null}">
                <Setter TargetName="Swatch" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsStacked}" Value="True">
                <Setter TargetName="Control" Property="Grid.Row" Value="1" />
                <Setter TargetName="Control" Property="Grid.Column" Value="0" />
                <Setter TargetName="Control" Property="Grid.ColumnSpan" Value="2" />
                <Setter TargetName="Control" Property="Width" Value="NaN" />
                <Setter TargetName="Control" Property="Margin" Value="0,3,0,0" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Flag">
                <Setter TargetName="Control" Property="Width" Value="NaN" />
                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                <Setter TargetName="CaptionText" Property="Foreground" Value="{StaticResource GhTextMuted}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsValid}" Value="False">
                <Setter TargetName="Number" Property="Foreground" Value="{StaticResource GhProblem}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--
    A row of a group box: a field as DimFieldTemplate lays it, or, for two boxes to tick that share a row, the caption with
    the two variables beside it and the two boxes with their words after them ("Suppress  DIMSD1 · DIMSD2  [ ] Dim line 1 [ ] Dim
    line 2"). Each box sits in a cell whose data is its field, so that the pointer and the focus tell the preview which it is.
    -->
    <DataTemplate x:Key="DimRowTemplate" DataType="{x:Type local:DimRowViewModel}">
        <Grid>
            <ContentControl
                x:Name="Single"
                Content="{Binding First}"
                ContentTemplate="{StaticResource DimFieldTemplate}"
                HorizontalContentAlignment="Stretch"
                Focusable="False"
            />
            <Grid x:Name="Both" Margin="0,2" MinHeight="24" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="{Binding Caption}" VerticalAlignment="Center" />
                    <TextBlock
                        Text="{Binding Variables}"
                        Margin="6,0,0,0"
                        FontSize="10"
                        FontFamily="{StaticResource GhMonoFont}"
                        Foreground="{StaticResource GhTextMuted}"
                        VerticalAlignment="Center"
                    />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border Style="{StaticResource DimPairCell}" DataContext="{Binding First}">
                        <CheckBox
                            Style="{StaticResource StyleCheck}"
                            Content="{Binding PairWords}"
                            IsChecked="{Binding IsChecked, Mode=TwoWay}"
                            IsEnabled="{Binding IsEnabled}"
                        />
                    </Border>
                    <Border Style="{StaticResource DimPairCell}" DataContext="{Binding Second}" Margin="12,0,0,0">
                        <CheckBox
                            Style="{StaticResource StyleCheck}"
                            Content="{Binding PairWords}"
                            IsChecked="{Binding IsChecked, Mode=TwoWay}"
                            IsEnabled="{Binding IsEnabled}"
                        />
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsPair}" Value="True">
                <Setter TargetName="Single" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Both" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--
    A group box of a tab: its title in the top line, its rows in one column, or two (24 apart) for the wide group.
    -->
    <DataTemplate x:Key="DimGroupTemplate" DataType="{x:Type local:DimGroupViewModel}">
        <GroupBox Header="{Binding Title}" Style="{StaticResource StyleGroupBox}" Margin="0,0,0,10">
            <ItemsControl ItemsSource="{Binding Columns}" Margin="-12,0" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ItemsControl
                            ItemsSource="{Binding}"
                            ItemTemplate="{StaticResource DimRowTemplate}"
                            Margin="12,0"
                            Focusable="False"
                        />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </GroupBox>
    </DataTemplate>
</ResourceDictionary>
