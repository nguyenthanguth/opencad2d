<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Deterministic>true</Deterministic>
        <IsPackable>false</IsPackable>
        <PlatformTarget>x64</PlatformTarget>
        <NoWarn>$(NoWarn);MSB3277</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
        <PackageReference Include="xunit" Version="2.9.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\Shared\ViewerSpeedCollection.cs" Link="ViewerSpeedCollection.cs" />
        <Compile Include="..\Shared\TimingTraitTests.cs" Link="TimingTraitTests.cs" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="GeometryHelper" HintPath="$(GeometryHelperLib)GeometryHelper.dll" />
        <ProjectReference Include="..\..\src\OpenCAD2D.Core\OpenCAD2D.Core.csproj" />
        <ProjectReference Include="..\..\src\OpenCAD2D.Remote\OpenCAD2D.Remote.csproj" />
        <ProjectReference Include="..\..\src\OpenCAD2D.Rendering\OpenCAD2D.Rendering.csproj" />
        <ProjectReference Include="..\..\src\OpenCAD2D.Mcp\OpenCAD2D.Mcp.csproj" />
        <!-- Built first, never referenced: the attach tests start its exe, a drawing app with no window. -->
        <ProjectReference
            Include="..\OpenCAD2D.Remote.TestServer\OpenCAD2D.Remote.TestServer.csproj"
            ReferenceOutputAssembly="false"
        />
    </ItemGroup>
</Project>
