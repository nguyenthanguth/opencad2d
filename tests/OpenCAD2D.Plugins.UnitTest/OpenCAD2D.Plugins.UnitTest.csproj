<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- net8.0-windows as well: the compiler of C# source plugins is on .NET 8 only, and it is the runtime the app ships on. -->
        <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
        <UseWPF Condition="'$(TargetFramework)' == 'net8.0-windows'">true</UseWPF>
        <LangVersion>latest</LangVersion>
        <Deterministic>true</Deterministic>
        <IsPackable>false</IsPackable>
        <PlatformTarget>x64</PlatformTarget>
        <NoWarn>$(NoWarn);MSB3277</NoWarn>
    </PropertyGroup>

    <!--
    On .NET 8 the tests of what only .NET 8 has, plugins given as C# source; the others are written for the loader of
    .NET Framework (they emit plugins with AssemblyBuilder.Save and expect the first build to stay loaded).
  -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
        <Compile Remove="**/*.cs" />
        <Compile Include="PluginFiles.cs;SourcePlugin*.cs" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\Shared\ViewerSpeedCollection.cs" Link="ViewerSpeedCollection.cs" />
        <Compile Include="..\Shared\TimingTraitTests.cs" Link="TimingTraitTests.cs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
        <PackageReference Include="xunit" Version="2.9.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="GeometryHelper" HintPath="$(GeometryHelperLib)GeometryHelper.dll" />
        <ProjectReference Include="..\..\src\OpenCAD2D.Core\OpenCAD2D.Core.csproj" />
        <ProjectReference Include="..\..\src\OpenCAD2D.Wpf\OpenCAD2D.Wpf.csproj" />
        <!-- Built first, never referenced: the tests load its .dll as a plugin, from SamplePlugin\ beside them. -->
        <ProjectReference
            Include="..\OpenCAD2D.SamplePlugin\OpenCAD2D.SamplePlugin.csproj"
            ReferenceOutputAssembly="false"
        />
        <!-- Built first, never referenced: the tests load its .dll as a plugin that adds to the window, from SampleUiPlugin\ beside them. -->
        <ProjectReference
            Include="..\OpenCAD2D.SampleUiPlugin\OpenCAD2D.SampleUiPlugin.csproj"
            ReferenceOutputAssembly="false"
        />
    </ItemGroup>

    <ItemGroup>
        <!-- The samples the app ships as Plugins\DrawingInfo, Plugins\DrawRandom and Plugins\HelloWorld: tests load them as the app does, from source. -->
        <None
            Include="..\..\examples\DrawingInfo\DrawingInfoCommands.cs"
            Link="DrawingInfo\DrawingInfoCommands.cs.txt"
            CopyToOutputDirectory="PreserveNewest"
            Visible="false"
        />
        <None
            Include="..\..\examples\DrawingInfo\DrawingInfo.csproj"
            Link="DrawingInfo\DrawingInfo.csproj.txt"
            CopyToOutputDirectory="PreserveNewest"
            Visible="false"
        />
        <None
            Include="..\..\examples\DrawRandom\DrawRandomCommands.cs"
            Link="DrawRandom\DrawRandomCommands.cs.txt"
            CopyToOutputDirectory="PreserveNewest"
            Visible="false"
        />
        <None
            Include="..\..\examples\DrawRandom\DrawRandom.csproj"
            Link="DrawRandom\DrawRandom.csproj.txt"
            CopyToOutputDirectory="PreserveNewest"
            Visible="false"
        />
        <None
            Include="..\..\examples\HelloWorld\HelloWorldCommands.cs"
            Link="HelloWorld\HelloWorldCommands.cs.txt"
            CopyToOutputDirectory="PreserveNewest"
            Visible="false"
        />
        <None
            Include="..\..\examples\HelloWorld\HelloWorld.csproj"
            Link="HelloWorld\HelloWorld.csproj.txt"
            CopyToOutputDirectory="PreserveNewest"
            Visible="false"
        />
        <!-- The plugin guide: a test reads its C# example and loads it. -->
        <None
            Include="..\..\docs\presenter\plugins.md"
            Link="Guide\plugins.md"
            CopyToOutputDirectory="PreserveNewest"
            Visible="false"
        />
    </ItemGroup>

    <ItemGroup>
        <None
            Include="..\OpenCAD2D.SamplePlugin\bin\$(Configuration)\netstandard2.0\OpenCAD2D.SamplePlugin.dll"
            Link="SamplePlugin\OpenCAD2D.SamplePlugin.dll"
            CopyToOutputDirectory="PreserveNewest"
            Visible="false"
        />
        <None
            Include="..\OpenCAD2D.SampleUiPlugin\bin\$(Configuration)\netstandard2.0\OpenCAD2D.SampleUiPlugin.dll"
            Link="SampleUiPlugin\OpenCAD2D.SampleUiPlugin.dll"
            CopyToOutputDirectory="PreserveNewest"
            Visible="false"
        />
    </ItemGroup>
</Project>
