<Project Sdk="Microsoft.NET.Sdk">
    <!--
    A drawing app with no window, serving the remote pipe, for the Python tests (tests/python/remote): a script in
    another process drives it as it would drive the real app. Started by the pytest fixture, never packed.
  -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <PlatformTarget>x64</PlatformTarget>
        <RootNamespace>OpenCAD2D.Remote.TestServer</RootNamespace>
        <AssemblyName>OpenCAD2D.Remote.TestServer</AssemblyName>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="GeometryHelper" HintPath="$(GeometryHelperLib)GeometryHelper.dll" />
        <ProjectReference Include="..\..\src\OpenCAD2D\OpenCAD2D.csproj" />
    </ItemGroup>
</Project>
