<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Deterministic>true</Deterministic>
        <IsPackable>false</IsPackable>
        <PlatformTarget>x64</PlatformTarget>
        <NoWarn>$(NoWarn);MSB3277</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
        <PackageReference Include="xunit" Version="2.9.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="GeometryHelper" HintPath="$(GeometryHelperLib)GeometryHelper.dll" />
        <ProjectReference Include="..\..\src\OpenCAD2D\OpenCAD2D.csproj" />
        <ProjectReference Include="..\..\src\OpenCAD2D.Remote\OpenCAD2D.Remote.csproj" />
        <ProjectReference Include="..\OpenCAD2D.Remote.Sample\OpenCAD2D.Remote.Sample.csproj" />
    </ItemGroup>
</Project>
