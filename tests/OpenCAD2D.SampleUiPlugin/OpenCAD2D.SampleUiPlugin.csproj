<Project Sdk="Microsoft.NET.Sdk">
    <!--
    The sample plugin that adds to the window (ribbon tab, Properties rows, DRAWINGS button, canvas menu, object snap),
    built for the plugin tests: they load its .dll as a user's plugin would be loaded. It references OpenCAD2D
    only, as a plugin does, and does not copy it: the presenter gives a plugin its own.
  -->
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsPackable>false</IsPackable>
        <RootNamespace>OpenCAD2D.SampleUiPlugin</RootNamespace>
        <AssemblyName>OpenCAD2D.SampleUiPlugin</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\OpenCAD2D.Core\OpenCAD2D.Core.csproj" Private="false" />
        <Reference Include="GeometryHelper" HintPath="$(GeometryHelperLib)GeometryHelper.dll" Private="false" />
    </ItemGroup>

    <ItemGroup>
        <!-- The 16 by 16 icon of the standard buttons, embedded as OpenCAD2D.SampleUiPlugin.circle16.png. -->
        <EmbeddedResource Include="circle16.png" />
    </ItemGroup>
</Project>
