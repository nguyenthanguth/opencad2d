<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Deterministic>true</Deterministic>
        <IsPackable>false</IsPackable>
        <PlatformTarget>x64</PlatformTarget>
        <NoWarn>$(NoWarn);MSB3277</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
        <PackageReference Include="xunit" Version="2.9.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="System.IO.Compression" />
        <Reference Include="System.Net.Http" />
        <Reference Include="System.IO.Compression.FileSystem" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\Shared\DxfDimensionDrawings.cs" Link="DxfDimensionDrawings.cs" />
        <Compile Include="..\Shared\FakeShareServer.cs" Link="FakeShareServer.cs" />
        <Compile Include="..\Shared\TrueTypeFile.cs" Link="TrueTypeFile.cs" />
        <Compile Include="..\Shared\SpeedGuard.cs" Link="SpeedGuard.cs" />
        <Compile Include="..\Shared\ViewerSpeedCollection.cs" Link="ViewerSpeedCollection.cs" />
        <Compile Include="..\Shared\TimingTraitTests.cs" Link="TimingTraitTests.cs" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="GeometryHelper" HintPath="$(GeometryHelperLib)GeometryHelper.dll" />
        <ProjectReference Include="..\..\src\OpenCAD2D.Core\OpenCAD2D.Core.csproj" />
        <ProjectReference Include="..\..\src\OpenCAD2D.Wpf\OpenCAD2D.Wpf.csproj" />
    </ItemGroup>
</Project>
